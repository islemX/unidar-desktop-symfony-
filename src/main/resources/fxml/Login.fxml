<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<StackPane xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="tn.unidar.desktop.controllers.LoginController"
           styleClass="login-bg"
           stylesheets="@../css/unidar-pages.css">

    <VBox maxWidth="440" spacing="28" alignment="CENTER"
          styleClass="glow-card"
          style="-fx-padding: 48 44 48 44;">

        <!-- Logo -->
        <VBox spacing="8" alignment="CENTER">
            <HBox spacing="10" alignment="CENTER">
                <Label text="⬡" style="-fx-text-fill: -fx-color-primary-600; -fx-font-size: 30px; -fx-font-weight: 800;"/>
                <Label text="UNIDAR" style="-fx-font-size: 24px; -fx-font-weight: 800; -fx-text-fill: -fx-color-surface-900; -fx-letter-spacing: 1px;"/>
            </HBox>
            <Label text="%login.welcome" style="-fx-font-size: 28px; -fx-font-weight: 800; -fx-text-fill: -fx-color-surface-900;"/>
            <Label text="%login.subtitle" style="-fx-text-fill: -fx-color-surface-500; -fx-font-size: 15px;"/>
        </VBox>

        <!-- Error alert -->
        <VBox fx:id="alertError" managed="false" visible="false" styleClass="alert-error">
            <Label fx:id="lblError" text="" styleClass="alert-error-text" wrapText="true"/>
        </VBox>

        <!-- Email -->
        <VBox spacing="7">
            <Label text="%login.email" styleClass="form-label"/>
            <TextField fx:id="txtEmail" promptText="you@example.com"
                       styleClass="form-input" onAction="#handleLogin"/>
        </VBox>

        <!-- Password -->
        <VBox spacing="7">
            <HBox>
                <Label text="%login.password" styleClass="form-label" HBox.hgrow="ALWAYS"/>
                <Hyperlink text="%login.forgot" style="-fx-font-size: 12px;"/>
            </HBox>
            <PasswordField fx:id="txtPassword" promptText="••••••••"
                           styleClass="form-input" onAction="#handleLogin"/>
        </VBox>

        <Button fx:id="btnLogin" text="%login.signin" styleClass="btn-primary"
                maxWidth="Infinity" prefHeight="54" onAction="#handleLogin"
                style="-fx-font-size: 16px; -fx-font-weight: 800;"/>

        <HBox alignment="CENTER" spacing="8">
            <Label text="%login.no_account" style="-fx-text-fill: -fx-color-surface-500; -fx-font-size: 14px;"/>
            <Hyperlink text="%login.signup" onAction="#gotoRegister"
                       style="-fx-font-weight: 800; -fx-text-fill: -fx-color-primary-600; -fx-font-size: 14px;"/>
        </HBox>

    </VBox>
</StackPane>
