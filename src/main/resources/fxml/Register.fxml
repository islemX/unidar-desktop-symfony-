<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<StackPane xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="tn.unidar.desktop.controllers.RegisterController"
           style="-fx-background-color: -fx-color-surface-50;"
           stylesheets="@../css/unidar-pages.css">

    <ScrollPane fitToWidth="true" styleClass="scroll-pane">
        <StackPane style="-fx-padding: 42 0 42 0; -fx-background-color: transparent;">

            <HBox maxWidth="560" spacing="0" alignment="CENTER"
                  style="-fx-padding: 0 20 0 20;">

                <!-- ── Registration Form ─────────────────── -->
                <VBox spacing="20" HBox.hgrow="ALWAYS" maxWidth="480"
                      styleClass="glow-card"
                      style="-fx-padding: 40 38 40 38;">

                    <!-- Logo / Title -->
                    <VBox spacing="6" alignment="CENTER">
                        <HBox spacing="10" alignment="CENTER">
                            <Label text="⬡" style="-fx-text-fill: -fx-color-primary-600; -fx-font-size: 30px; -fx-font-weight: 800;"/>
                            <Label text="UNIDAR"
                                   style="-fx-font-size: 24px; -fx-font-weight: 800; -fx-text-fill: -fx-color-surface-900; -fx-letter-spacing: 1px;"/>
                        </HBox>
                        <Label text="%reg.title"
                               style="-fx-font-size: 26px; -fx-font-weight: 800; -fx-text-fill: -fx-color-surface-900;"/>
                        <Label text="%reg.subtitle"
                               style="-fx-text-fill: -fx-color-surface-500; -fx-font-size: 14px;"/>
                    </VBox>

                    <!-- Error alert -->
                    <VBox fx:id="alertError" managed="false" visible="false" styleClass="alert-error">
                        <Label fx:id="lblError" text="" styleClass="alert-error-text" wrapText="true"/>
                    </VBox>

                    <!-- Role selector -->
                    <VBox spacing="10">
                        <Label text="%reg.i_am" styleClass="form-label"/>
                        <HBox spacing="12">
                            <ToggleButton fx:id="btnStudent" text="%reg.student"
                                          maxWidth="Infinity" HBox.hgrow="ALWAYS"
                                          onAction="#selectStudent"
                                          style="-fx-background-color: -fx-color-primary-600; -fx-text-fill: white;
                                                 -fx-background-radius: 12; -fx-padding: 12 0;
                                                 -fx-font-weight: 800; -fx-cursor: hand;"/>
                            <ToggleButton fx:id="btnOwner" text="%reg.owner"
                                          maxWidth="Infinity" HBox.hgrow="ALWAYS"
                                          onAction="#selectOwner"
                                          style="-fx-background-color: -fx-color-surface-100; -fx-text-fill: -fx-color-surface-500;
                                                 -fx-background-radius: 12; -fx-padding: 12 0; -fx-cursor: hand; -fx-font-weight: bold;"/>
                        </HBox>
                    </VBox>

                    <!-- Full Name -->
                    <VBox spacing="6">
                        <Label text="%reg.full_name" styleClass="form-label"/>
                        <TextField fx:id="txtFullName" promptText="Your full name" styleClass="form-input"/>
                    </VBox>

                    <!-- Email -->
                    <VBox spacing="6">
                        <Label text="%reg.email" styleClass="form-label"/>
                        <TextField fx:id="txtEmail" promptText="you@example.com" styleClass="form-input"/>
                    </VBox>

                    <!-- Phone -->
                    <VBox spacing="6">
                        <Label text="%reg.phone" styleClass="form-label"/>
                        <TextField fx:id="txtPhone" promptText="+216 XX XXX XXX" styleClass="form-input"/>
                    </VBox>

                    <!-- Gender + City (side by side) -->
                    <HBox spacing="12">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="%reg.gender" styleClass="form-label"/>
                            <ComboBox fx:id="comboGender" maxWidth="Infinity" styleClass="combo-box"
                                      promptText="%common.select"/>
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="%reg.city" styleClass="form-label"/>
                            <ComboBox fx:id="comboCity" maxWidth="Infinity" styleClass="combo-box"
                                      promptText="%common.select"/>
                        </VBox>
                    </HBox>

                    <!-- University (students) -->
                    <VBox fx:id="uniSection" spacing="6">
                        <Label text="%reg.university" styleClass="form-label"/>
                        <ComboBox fx:id="comboUniversity" maxWidth="Infinity" styleClass="combo-box"
                                  promptText="%reg.uni_prompt"/>
                    </VBox>

                    <!-- Password -->
                    <VBox spacing="6">
                        <Label text="%reg.password" styleClass="form-label"/>
                        <PasswordField fx:id="txtPassword" promptText="At least 8 characters" styleClass="form-input"/>
                    </VBox>

                    <!-- Confirm Password -->
                    <VBox spacing="6">
                        <Label text="%reg.confirm" styleClass="form-label"/>
                        <PasswordField fx:id="txtConfirmPassword" promptText="Re-enter your password" styleClass="form-input"/>
                    </VBox>

                    <Button fx:id="btnRegister" text="%reg.create" styleClass="btn-primary"
                            maxWidth="Infinity" prefHeight="54" onAction="#handleRegister"
                            style="-fx-font-size: 16px; -fx-font-weight: 800;"/>

                    <HBox alignment="CENTER" spacing="8">
                        <Label text="%reg.have_account" style="-fx-text-fill: -fx-color-surface-500; -fx-font-size: 14px;"/>
                        <Hyperlink text="%reg.signin" onAction="#gotoLogin"
                                   style="-fx-font-weight: 800; -fx-text-fill: -fx-color-primary-600; -fx-font-size: 14px;"/>
                    </HBox>

                </VBox>

            </HBox>
        </StackPane>
    </ScrollPane>
</StackPane>
