<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.unidar.desktop.controllers.AdminUsersController"
            style="-fx-background-color: #f8fafc;"
            stylesheets="@../css/unidar-pages.css">

    <top>
        <VBox style="-fx-background-color: white;
                     -fx-border-color: transparent transparent #e2e8f0 transparent;
                     -fx-border-width: 0 0 1 0; -fx-padding: 24 36 20 36;" spacing="16">
            <HBox spacing="16" alignment="CENTER_LEFT">
                <VBox HBox.hgrow="ALWAYS" spacing="4">
                    <Label text="👥  User Management" styleClass="page-title"/>
                    <Label fx:id="lblCount" text="Loading..." styleClass="page-subtitle"/>
                </VBox>
                <Button text="← Back to Dashboard" styleClass="btn-ghost" onAction="#goBack"/>
            </HBox>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <TextField fx:id="txtSearch" promptText="🔍  Search by name or email..."
                           styleClass="form-input" prefWidth="320" HBox.hgrow="ALWAYS"
                           onAction="#handleSearch"/>
                <ComboBox fx:id="comboRole" promptText="All Roles" styleClass="combo-box" prefWidth="140"/>
                <Button text="Search" styleClass="btn-primary" onAction="#handleSearch"/>
                <Button text="Clear" styleClass="btn-ghost" onAction="#clearSearch"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox style="-fx-background-color: #f8fafc;">

            <VBox fx:id="loadingPane" alignment="CENTER" spacing="12"
                  style="-fx-padding: 80;" managed="true" visible="true">
                <ProgressIndicator prefWidth="48" prefHeight="48" style="-fx-accent: #4f46e5;"/>
                <Label text="Loading users..." style="-fx-text-fill: #64748b;"/>
            </VBox>

            <VBox fx:id="emptyPane" alignment="CENTER" spacing="16"
                  style="-fx-padding: 80;" managed="false" visible="false">
                <Label text="👤" style="-fx-font-size: 48px;"/>
                <Label text="No users found"
                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
            </VBox>

            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                        style="-fx-background-color: transparent; -fx-background: transparent;">
                <VBox fx:id="usersContainer" spacing="1"
                      style="-fx-background-color: #f8fafc; -fx-padding: 24 36 24 36;"/>
            </ScrollPane>

        </VBox>
    </center>

</BorderPane>
