<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.unidar.desktop.controllers.AdminReportsController"
            style="-fx-background-color: #f8fafc;"
            stylesheets="@../css/unidar-pages.css">

    <top>
        <VBox style="-fx-background-color: white;
                     -fx-border-color: transparent transparent #e2e8f0 transparent;
                     -fx-border-width: 0 0 1 0; -fx-padding: 24 36 20 36;" spacing="16">
            <HBox spacing="16" alignment="CENTER_LEFT">
                <VBox HBox.hgrow="ALWAYS" spacing="4">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="🚩" style="-fx-font-size: 24px;"/>
                        <Label fx:id="lblTitle" text="Reports Management" styleClass="page-title"/>
                    </HBox>
                    <Label fx:id="lblCount" text="Loading..." styleClass="page-subtitle"/>
                </VBox>
                <Button fx:id="btnBack" text="← Back to Dashboard" styleClass="btn-ghost" onAction="#goBack"/>
            </HBox>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="Status:" style="-fx-font-weight: bold; -fx-text-fill: #374151;"/>
                <ComboBox fx:id="comboStatus" promptText="open" styleClass="combo-box" prefWidth="160"/>
                <Button fx:id="btnFilter" text="Filter" styleClass="btn-primary" onAction="#handleFilter"/>
                <Button fx:id="btnRefresh" text="↻ Refresh" styleClass="btn-ghost" onAction="#refresh"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox style="-fx-background-color: #f8fafc;">

            <VBox fx:id="loadingPane" alignment="CENTER" spacing="12"
                  style="-fx-padding: 80;" managed="true" visible="true">
                <ProgressIndicator prefWidth="48" prefHeight="48" style="-fx-accent: #4f46e5;"/>
                <Label text="Loading reports..." style="-fx-text-fill: #64748b;"/>
            </VBox>

            <VBox fx:id="emptyPane" alignment="CENTER" spacing="16"
                  style="-fx-padding: 80;" managed="false" visible="false">
                <Label text="🚩" style="-fx-font-size: 48px;"/>
                <Label text="No reports found"
                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                <Label text="All reports have been resolved or there are no submissions yet."
                       style="-fx-text-fill: #64748b; -fx-font-size: 13px;" wrapText="true" textAlignment="CENTER"/>
            </VBox>

            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                        style="-fx-background-color: transparent; -fx-background: transparent;">
                <VBox fx:id="reportsContainer" spacing="14"
                      style="-fx-background-color: #f8fafc; -fx-padding: 24 36 24 36;"/>
            </ScrollPane>

        </VBox>
    </center>

</BorderPane>
