<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<ScrollPane fitToWidth="true" xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.unidar.desktop.controllers.ListingDetailController"
            styleClass="scroll-pane"
            stylesheets="@../css/unidar-pages.css">

    <VBox spacing="0">

        <!-- ── Top Nav Bar ── -->
        <HBox styleClass="detail-nav-bar" alignment="CENTER_LEFT" spacing="16">
            <Button text="← Back" styleClass="btn-ghost-nav" onAction="#goBack"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblNavTitle" text="" styleClass="detail-nav-title"/>
        </HBox>

        <VBox style="-fx-padding: 28 40 48 40;" spacing="28">

            <!-- ── Gallery ── -->
            <StackPane fx:id="galleryRoot" prefHeight="460" maxWidth="Infinity" styleClass="gallery-pro">
                <StackPane fx:id="mainImageContainer" prefHeight="460" maxWidth="Infinity"/>

                <!-- Counter badge -->
                <Label fx:id="lblImageCounter" text="1 / 1" StackPane.alignment="TOP_RIGHT"
                       styleClass="gallery-counter">
                    <StackPane.margin><Insets top="16" right="16"/></StackPane.margin>
                </Label>

                <!-- Nav buttons -->
                <HBox alignment="CENTER" spacing="0" pickOnBounds="false" maxHeight="460">
                    <Button text="‹" onAction="#prevImage" styleClass="gallery-nav-btn"
                            style="-fx-font-size: 26px;">
                        <HBox.margin><Insets left="16"/></HBox.margin>
                    </Button>
                    <Region HBox.hgrow="ALWAYS" pickOnBounds="false"/>
                    <Button text="›" onAction="#nextImage" styleClass="gallery-nav-btn"
                            style="-fx-font-size: 26px;">
                        <HBox.margin><Insets right="16"/></HBox.margin>
                    </Button>
                </HBox>

                <!-- Thumbnails strip at bottom -->
                <HBox StackPane.alignment="BOTTOM_CENTER" pickOnBounds="false"
                      style="-fx-padding: 0 0 18 0;">
                    <ScrollPane fitToHeight="true" vbarPolicy="NEVER" hbarPolicy="NEVER"
                                style="-fx-background-color: transparent; -fx-background: transparent;"
                                maxWidth="680">
                        <HBox fx:id="thumbnailsContainer" spacing="8" alignment="CENTER"
                              style="-fx-padding: 10 20 10 20; -fx-background-color: rgba(0,0,0,0.4); -fx-background-radius: 14;"/>
                    </ScrollPane>
                </HBox>
            </StackPane>

            <!-- ── Content Grid ── -->
            <HBox spacing="28" alignment="TOP_LEFT">

                <!-- Left – Info Panel -->
                <VBox spacing="24" HBox.hgrow="ALWAYS">

                    <!-- Title Block -->
                    <VBox spacing="10" styleClass="detail-section-card">
                        <HBox spacing="8">
                            <Label fx:id="lblType"   text="Apartment" styleClass="badge, badge-primary"/>
                            <Label fx:id="lblGender" text="Mixed"     styleClass="badge, badge-neutral"/>
                            <Label fx:id="lblStatus" text="Available" styleClass="badge, badge-success"/>
                        </HBox>
                        <Label fx:id="lblTitle" text="Loading..." styleClass="detail-title" wrapText="true"/>
                        <HBox spacing="6" alignment="CENTER_LEFT">
                            <Label text="📍" style="-fx-font-size: 15px;"/>
                            <Label fx:id="lblAddress" text="Loading..." styleClass="detail-address"/>
                        </HBox>
                    </VBox>

                    <!-- Stats Row -->
                    <HBox spacing="0" styleClass="stats-bar">
                        <VBox spacing="3" alignment="CENTER" HBox.hgrow="ALWAYS">
                            <Label fx:id="lblPrice" text="—" styleClass="stat-price"/>
                            <Label text="%detail.per_month" styleClass="stat-label"/>
                        </VBox>
                        <Separator orientation="VERTICAL" styleClass="stat-sep"/>
                        <VBox spacing="3" alignment="CENTER" HBox.hgrow="ALWAYS">
                            <Label fx:id="lblBedrooms" text="—" styleClass="stat-value"/>
                            <Label text="%detail.bedrooms" styleClass="stat-label"/>
                        </VBox>
                        <Separator orientation="VERTICAL" styleClass="stat-sep"/>
                        <VBox spacing="3" alignment="CENTER" HBox.hgrow="ALWAYS">
                            <Label fx:id="lblBaths" text="—" styleClass="stat-value"/>
                            <Label text="%detail.bathrooms" styleClass="stat-label"/>
                        </VBox>
                        <Separator orientation="VERTICAL" styleClass="stat-sep"/>
                        <VBox spacing="3" alignment="CENTER" HBox.hgrow="ALWAYS">
                            <Label fx:id="lblCapacity" text="—" styleClass="stat-value"/>
                            <Label text="%detail.capacity" styleClass="stat-label"/>
                        </VBox>
                        <Separator orientation="VERTICAL" styleClass="stat-sep"/>
                        <VBox spacing="3" alignment="CENTER" HBox.hgrow="ALWAYS">
                            <Label fx:id="lblRemaining" text="—" styleClass="stat-value-brand"/>
                            <Label text="%detail.available" styleClass="stat-label"/>
                        </VBox>
                        <Separator orientation="VERTICAL" styleClass="stat-sep"/>
                        <VBox spacing="3" alignment="CENTER" HBox.hgrow="ALWAYS">
                            <Label fx:id="lblFloor" text="—" styleClass="stat-value"/>
                            <Label text="%detail.floor" styleClass="stat-label"/>
                        </VBox>
                    </HBox>

                    <!-- Description -->
                    <VBox spacing="12" styleClass="detail-section-card">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label text="📖" style="-fx-font-size: 18px;"/>
                            <Label text="%detail.about" styleClass="section-title"/>
                        </HBox>
                        <Label fx:id="lblDescription" text="%common.loading"
                               styleClass="detail-description" wrapText="true"/>
                    </VBox>

                    <!-- Amenities -->
                    <VBox spacing="12" styleClass="detail-section-card">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label text="✨" style="-fx-font-size: 18px;"/>
                            <Label text="%detail.included" styleClass="section-title"/>
                        </HBox>
                        <FlowPane fx:id="amenitiesPane" hgap="10" vgap="10"/>
                    </VBox>

                    <!-- Roommates Section -->
                    <VBox fx:id="roommatesSection" spacing="12" styleClass="detail-section-card">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label text="👥" style="-fx-font-size: 18px;"/>
                            <Label text="%detail.roommates" styleClass="section-title"/>
                        </HBox>
                        <VBox fx:id="roommatesContainer" spacing="12"/>
                    </VBox>

                    <!-- Location -->
                    <VBox spacing="12" styleClass="detail-section-card">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label text="📍" style="-fx-font-size: 18px;"/>
                            <Label text="%detail.location" styleClass="section-title"/>
                        </HBox>
                        <HBox spacing="12" alignment="CENTER_LEFT"
                              style="-fx-background-color: #f8fafc; -fx-background-radius: 13; -fx-padding: 16 20;
                                     -fx-border-color: #e2e8f0; -fx-border-radius: 13; -fx-border-width: 1;">
                            <Label text="🏙️" style="-fx-font-size: 22px;"/>
                            <VBox spacing="2">
                                <Label fx:id="lblFullAddress" text="%common.loading"
                                       style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #0f172a;"
                                       wrapText="true"/>
                                <Label text="%detail.location_tip"
                                       style="-fx-text-fill: #94a3b8; -fx-font-size: 12px;" wrapText="true"/>
                            </VBox>
                        </HBox>
                    </VBox>

                </VBox>

                <!-- Right – Actions Sidebar -->
                <VBox spacing="14" prefWidth="320" minWidth="290">

                    <!-- Price card -->
                    <VBox styleClass="action-card" spacing="20">

                        <!-- Price hero -->
                        <VBox spacing="2">
                            <Label fx:id="lblSidebarPrice" text="0 TND" styleClass="price-hero"/>
                            <Label text="%detail.per_month" styleClass="price-sub"/>
                        </VBox>

                        <!-- Quick stats -->
                        <HBox spacing="0" style="-fx-background-color: #f8fafc; -fx-background-radius: 14;
                                                  -fx-border-color: #e2e8f0; -fx-border-radius: 14; -fx-border-width: 1;">
                            <VBox spacing="3" alignment="CENTER" HBox.hgrow="ALWAYS" style="-fx-padding: 14 8;">
                                <Label text="👥" style="-fx-font-size: 20px;"/>
                                <Label fx:id="lblSidebarRemaining" text="—"
                                       style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #4f46e5;"/>
                                <Label text="Places" style="-fx-font-size: 10px; -fx-text-fill: #94a3b8; -fx-font-weight: bold;"/>
                            </VBox>
                            <Separator orientation="VERTICAL"/>
                            <VBox spacing="3" alignment="CENTER" HBox.hgrow="ALWAYS" style="-fx-padding: 14 8;">
                                <Label text="🏠" style="-fx-font-size: 20px;"/>
                                <Label fx:id="lblSidebarFloor" text="—"
                                       style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #0f172a;"/>
                                <Label text="Étage" style="-fx-font-size: 10px; -fx-text-fill: #94a3b8; -fx-font-weight: bold;"/>
                            </VBox>
                        </HBox>

                        <!-- Owner info -->
                        <VBox spacing="8" style="-fx-background-color: #f8fafc; -fx-background-radius: 12;
                                                  -fx-padding: 14 16; -fx-border-color: #e2e8f0;
                                                  -fx-border-radius: 12; -fx-border-width: 1;">
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Label text="👤" style="-fx-font-size: 15px;"/>
                                <Label fx:id="lblOwnerName" text="—"
                                       style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #0f172a;"/>
                            </HBox>
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Label text="📅" style="-fx-font-size: 14px;"/>
                                <Label fx:id="lblPosted" text="—"
                                       style="-fx-text-fill: #64748b; -fx-font-size: 12px;"/>
                            </HBox>
                        </VBox>

                        <!-- CTA Buttons -->
                        <Button fx:id="btnContact" text="💬   %detail.contact"
                                styleClass="btn-primary-full" maxWidth="Infinity" prefHeight="50"
                                onAction="#contactOwner"/>
                        <Button fx:id="btnContract" text="📋   %detail.sign_contract"
                                styleClass="btn-contract-full" maxWidth="Infinity" prefHeight="50"
                                onAction="#generateContract"/>
                        <Button fx:id="btnSave" text="🤍   %detail.save"
                                styleClass="btn-secondary-full" maxWidth="Infinity" prefHeight="46"
                                onAction="#toggleSave"/>

                        <!-- Trust hint -->
                        <Label text="💡 %detail.verify_tip" styleClass="trust-hint" wrapText="true"/>
                    </VBox>

                    <!-- Report -->
                    <Button text="🚩  %detail.report" styleClass="btn-report"
                            maxWidth="Infinity" onAction="#reportListing"/>
                </VBox>

            </HBox>
        </VBox>
    </VBox>
</ScrollPane>
