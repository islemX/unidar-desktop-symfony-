# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5432/app?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> app/voice-commander ###
# Optional — URL of a local faster-whisper/Kokoro microservice.
# Leave empty to use the browser's native Web Speech API (default, zero-setup).
# Example: VOICE_SERVICE_URL=http://127.0.0.1:8765
VOICE_SERVICE_URL=
###< app/voice-commander ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=changeme_in_production
###< lexik/jwt-authentication-bundle ###

###> knp/snappy-bundle ###
# Path to wkhtmltopdf binary (install separately)
# Linux: WKHTMLTOPDF_PATH=/usr/bin/wkhtmltopdf
# Windows: WKHTMLTOPDF_PATH=C:/Program Files/wkhtmltopdf/bin/wkhtmltopdf.exe
WKHTMLTOPDF_PATH=/usr/bin/wkhtmltopdf
###< knp/snappy-bundle ###

###> sentry/sentry-symfony ###
# Add your Sentry DSN in .env.local (do not commit)
# SENTRY_DSN=https://your-dsn@sentry.io/project-id
SENTRY_DSN=
###< sentry/sentry-symfony ###

###> app/notifier ###
ADMIN_EMAIL=admin@unidar.app
###< app/notifier ###

###> app/platform ###
# Platform commission rate applied on each rental payment (e.g. 0.05 = 5 %)
COMMISSION_RATE=0.05
###< app/platform ###

###> symfony/mailer ###
# For Gmail: smtp+starttls://your_gmail@gmail.com:your_app_password@smtp.gmail.com:587
# ── OPTION A: Brevo (recommended for MENA — 300 free emails/day)
#    SMTP key: Brevo Dashboard → SMTP & API → SMTP → Generate key
MAILER_DSN=smtp://YOUR_BREVO_LOGIN:YOUR_BREVO_SMTP_KEY@smtp-relay.brevo.com:587
#
# ── OPTION B: Resend (developer-friendly — 100 free emails/day)
#MAILER_DSN=smtp://resend:YOUR_RESEND_API_KEY@smtp.resend.com:465
#
# ── OPTION C: Mailtrap (safe local testing — emails never delivered)
#MAILER_DSN=smtp://user:pass@sandbox.smtp.mailtrap.io:2525
#
# ── OPTION D: Null (no sending at all)
#MAILER_DSN=null://null

# Sender identity — must match your verified domain in Brevo/Resend
MAILER_FROM_EMAIL=noreply@unidar.app
MAILER_FROM_NAME=UNIDAR
###< symfony/mailer ###

###> google/recaptcha ###
# Get keys at https://www.google.com/recaptcha/admin/create  (choose reCAPTCHA v2 "I'm not a robot")
# For local dev testing, use the universal test keys:
#   SITE KEY:   6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
#   SECRET KEY: 6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe
RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe
###< google/recaptcha ###

# LLM Configuration (Ollama local or OpenAI-compatible)
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=llama3
LLM_API_KEY=
