<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<ScrollPane fitToWidth="true" xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.unidar.desktop.controllers.DashboardController"
            styleClass="scroll-pane"
            stylesheets="@../css/unidar-pages.css">

    <VBox styleClass="page-bg" spacing="28">

        <!-- ── Page Header ── -->
        <HBox spacing="20" alignment="CENTER_LEFT">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label fx:id="lblWelcome" text="Welcome back! 👋" styleClass="page-title"/>
                <Label text="Here's what's happening with your housing journey." styleClass="page-subtitle"/>
            </VBox>
            <Button text="+ Browse Listings" styleClass="btn-primary"
                    onAction="#gotoListings"/>
        </HBox>

        <!-- ── Stats Row ── -->
        <HBox spacing="20">
            <VBox styleClass="stat-card, stat-blue" spacing="8" HBox.hgrow="ALWAYS">
                <Label text="📌" style="-fx-font-size: 26px;"/>
                <Label fx:id="lblSaved" text="0" styleClass="stat-number"/>
                <Label text="Saved Listings" styleClass="stat-label"/>
            </VBox>
            <VBox styleClass="stat-card, stat-green" spacing="8" HBox.hgrow="ALWAYS">
                <Label text="📋" style="-fx-font-size: 26px;"/>
                <Label fx:id="lblContracts" text="0" styleClass="stat-number"/>
                <Label text="Active Contracts" styleClass="stat-label"/>
            </VBox>
            <VBox styleClass="stat-card, stat-violet" spacing="8" HBox.hgrow="ALWAYS">
                <Label text="💬" style="-fx-font-size: 26px;"/>
                <Label fx:id="lblMessages" text="0" styleClass="stat-number"/>
                <Label text="Unread Messages" styleClass="stat-label"/>
            </VBox>
            <VBox styleClass="stat-card, stat-amber" spacing="8" HBox.hgrow="ALWAYS">
                <Label text="🤝" style="-fx-font-size: 26px;"/>
                <Label fx:id="lblMatches" text="0" styleClass="stat-number"/>
                <Label text="Roommate Matches" styleClass="stat-label"/>
            </VBox>
        </HBox>

        <!-- ── Verification Banner (conditional) ── -->
        <VBox fx:id="verificationBanner" managed="false" visible="false">
            <HBox styleClass="alert-warning" spacing="16" alignment="CENTER_LEFT">
                <Label text="⚠️" style="-fx-font-size: 20px;"/>
                <VBox HBox.hgrow="ALWAYS" spacing="2">
                    <Label text="Verify Your Identity to Unlock All Features" style="-fx-font-weight: bold; -fx-text-fill: -fx-color-warning;"/>
                    <Label text="Upload your Student ID and CIN to access roommate matching and contracts." styleClass="alert-warning-text"/>
                </VBox>
                <Button text="Verify Now →" styleClass="btn-primary, btn-sm" onAction="#gotoVerification"/>
            </HBox>
        </VBox>

        <!-- ── Premium Banner (conditional) ── -->
        <VBox fx:id="premiumBanner" managed="false" visible="false">
            <HBox styleClass="banner-premium" spacing="16" alignment="CENTER_LEFT">
                <Label text="⭐" style="-fx-font-size: 22px;"/>
                <VBox HBox.hgrow="ALWAYS" spacing="2">
                    <Label text="Unlock Premium — 25 TND / year" style="-fx-font-weight: bold; -fx-text-fill: white; -fx-font-size: 15px;"/>
                    <Label text="Roommate matching, unlimited messaging, digital contracts, and more." style="-fx-text-fill: rgba(255,255,255,0.8); -fx-font-size: 13px;"/>
                </VBox>
                <Button text="Upgrade ⭐" styleClass="btn-white" onAction="#gotoSubscription"/>
            </HBox>
        </VBox>

        <!-- ── Main Grid ── -->
        <HBox spacing="20" VBox.vgrow="ALWAYS">

            <!-- Left Column -->
            <VBox spacing="20" prefWidth="320" minWidth="280">

                <!-- Profile Card -->
                <VBox styleClass="glow-card" spacing="20" alignment="CENTER">
                    <Label fx:id="lblProfileAvatar" text="U" styleClass="avatar-indigo"
                           style="-fx-min-width: 90; -fx-min-height: 90;
                                  -fx-max-width: 90; -fx-max-height: 90;
                                  -fx-font-size: 34px;"/>
                    <VBox spacing="6" alignment="CENTER">
                        <Label fx:id="lblProfileName" text="Your Name"
                               style="-fx-font-size: 20px; -fx-font-weight: 800; -fx-text-fill: -fx-color-surface-900;"/>
                        <Label fx:id="lblProfileEmail" text="email@example.com"
                               style="-fx-text-fill: -fx-color-surface-500; -fx-font-size: 14px;"/>
                        <HBox spacing="8" alignment="CENTER" style="-fx-padding: 6 0 0 0;">
                            <Label fx:id="lblProfileRole" text="Student" styleClass="badge-gradient"/>
                            <Label fx:id="lblVerifStatus" text="Unverified" styleClass="badge-neutral"/>
                        </HBox>
                    </VBox>
                    <Separator maxWidth="Infinity"/>
                    <HBox spacing="24" alignment="CENTER">
                        <VBox alignment="CENTER" spacing="4">
                            <Label fx:id="lblStatSaved2" text="0"
                                   style="-fx-font-size: 22px; -fx-font-weight: 800; -fx-text-fill: -fx-color-primary-600;"/>
                            <Label text="Saved" style="-fx-text-fill: -fx-color-surface-400; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                        </VBox>
                        <VBox alignment="CENTER" spacing="4">
                            <Label fx:id="lblStatContracts2" text="0"
                                   style="-fx-font-size: 22px; -fx-font-weight: 800; -fx-text-fill: -fx-color-success;"/>
                            <Label text="Contracts" style="-fx-text-fill: -fx-color-surface-400; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                        </VBox>
                        <VBox alignment="CENTER" spacing="4">
                            <Label fx:id="lblStatMessages2" text="0"
                                   style="-fx-font-size: 22px; -fx-font-weight: 800; -fx-text-fill: -fx-color-violet-600;"/>
                            <Label text="Messages" style="-fx-text-fill: -fx-color-surface-400; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- Quick Actions -->
                <VBox styleClass="card" spacing="12">
                    <Label text="Quick Actions" styleClass="section-header"/>
                    <Button text="🔍  Search Listings"       styleClass="btn-ghost" maxWidth="Infinity" onAction="#gotoListings"/>
                    <Button text="🤝  Find Roommates"        styleClass="btn-ghost" maxWidth="Infinity" onAction="#gotoRoommates"/>
                    <Button text="💬  Open Messages"         styleClass="btn-ghost" maxWidth="Infinity" onAction="#gotoMessages"/>
                    <Button text="🛡️  Identity Verification"  styleClass="btn-ghost" maxWidth="Infinity" onAction="#gotoVerification"/>
                    <Button text="⭐  Upgrade to Premium"    styleClass="btn-ghost" maxWidth="Infinity" onAction="#gotoSubscription"/>
                </VBox>

            </VBox>

            <!-- Right Column -->
            <VBox spacing="20" HBox.hgrow="ALWAYS">

                <!-- Recent Messages -->
                <VBox styleClass="card" spacing="14">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="💬  Recent Messages" styleClass="section-header" HBox.hgrow="ALWAYS"/>
                        <Button text="View All" styleClass="btn-ghost, btn-sm" onAction="#gotoMessages"/>
                    </HBox>
                    <VBox fx:id="messagesPreview" spacing="10">
                        <Label text="No messages yet. Start a conversation!" styleClass="empty-state"
                               maxWidth="Infinity" alignment="CENTER"/>
                    </VBox>
                </VBox>

                <!-- Active Contracts -->
                <VBox styleClass="card" spacing="14">
                    <Label text="📋  Active Contracts" styleClass="section-header"/>
                    <VBox fx:id="contractsList" spacing="10">
                        <Label text="No active contracts." styleClass="empty-state"
                               maxWidth="Infinity" alignment="CENTER"/>
                    </VBox>
                </VBox>

                <!-- Saved Listings -->
                <VBox styleClass="card" spacing="14">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="❤️  Saved Listings" styleClass="section-header" HBox.hgrow="ALWAYS"/>
                        <Button text="Browse More" styleClass="btn-ghost, btn-sm" onAction="#gotoListings"/>
                    </HBox>
                    <FlowPane fx:id="savedListingsGrid" hgap="14" vgap="14">
                        <Label text="No saved listings yet. Browse and save listings you like!"
                               styleClass="empty-state" wrapText="true" maxWidth="500"/>
                    </FlowPane>
                </VBox>

            </VBox>
        </HBox>
    </VBox>
</ScrollPane>
