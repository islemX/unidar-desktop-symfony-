{% extends 'admin/base.html.twig' %}

{% block title %}Anomaly Report — AI Admin{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
.ar-hero {
    background: linear-gradient(135deg, #0f172a 0%, #130c23 50%, #0f172a 100%);
    padding: 2rem 2rem 1.5rem;
    border-bottom: 1px solid #2a1a4a;
    position: relative; overflow: hidden;
}
.ar-hero::before {
    content: '';
    position: absolute; inset: 0;
    background-image: radial-gradient(circle, rgba(139,92,246,.07) 1px, transparent 1px);
    background-size: 28px 28px;
    pointer-events: none;
}
.ar-hero-title { font-size: 1.7rem; font-weight: 800; color: #f1f5f9; position: relative; }
.ar-hero-sub   { color: #94a3b8; margin-top: .3rem; position: relative; }
.ar-back-btn {
    display: inline-flex; align-items: center; gap: .5rem;
    padding: .5rem 1rem; border-radius: 8px;
    background: rgba(255,255,255,.06); border: 1px solid #334155;
    color: #cbd5e1; font-size: .85rem; text-decoration: none; transition: background .2s;
}
.ar-back-btn:hover { background: rgba(255,255,255,.1); color: #f1f5f9; }

.ar-body { padding: 1.5rem 2rem; background: #0f172a; min-height: 60vh; }

.ar-table-wrap { background: #1e293b; border: 1px solid #334155; border-radius: 12px; overflow: hidden; }
.ar-table { width: 100%; border-collapse: collapse; }
.ar-table thead th {
    background: rgba(139,92,246,.08);
    padding: .9rem 1.1rem; text-align: left;
    font-size: .75rem; font-weight: 700; text-transform: uppercase; letter-spacing: .06em;
    color: #94a3b8; border-bottom: 1px solid #334155;
}
.ar-table tbody tr { border-bottom: 1px solid rgba(51,65,85,.5); transition: background .15s; }
.ar-table tbody tr:last-child { border-bottom: none; }
.ar-table tbody tr:hover { background: rgba(255,255,255,.03); }
.ar-table td { padding: .9rem 1.1rem; color: #cbd5e1; font-size: .88rem; vertical-align: middle; }

.ar-score {
    display: inline-flex; align-items: center; justify-content: center;
    width: 44px; height: 44px; border-radius: 50%;
    font-weight: 800; font-size: .95rem;
}
.ar-score-critical   { background: rgba(239,68,68,.15);  color: #f87171; border: 2px solid rgba(239,68,68,.3); }
.ar-score-suspicious { background: rgba(245,158,11,.15); color: #fbbf24; border: 2px solid rgba(245,158,11,.3); }
.ar-score-watch      { background: rgba(139,92,246,.12); color: #c4b5fd; border: 2px solid rgba(139,92,246,.25); }

.ar-level-pill {
    display: inline-block; padding: .22rem .65rem; border-radius: 20px;
    font-size: .72rem; font-weight: 700; text-transform: uppercase; letter-spacing: .05em;
}
.ar-level-critical   { background: rgba(239,68,68,.12);  color: #f87171; }
.ar-level-suspicious { background: rgba(245,158,11,.12); color: #fbbf24; }
.ar-level-watch      { background: rgba(139,92,246,.1);  color: #c4b5fd; }

.ar-signal-list { list-style: none; padding: 0; margin: 0; }
.ar-signal-list li { font-size: .78rem; color: #94a3b8; padding: .1rem 0; }
.ar-signal-list li::before { content: '⚡ '; }

.ar-expl { font-size: .8rem; color: #7dd3fc; font-style: italic; }
.ar-action { font-size: .8rem; color: #86efac; }

.ar-empty { text-align: center; padding: 4rem 1rem; color: #64748b; }
.ar-empty-icon { font-size: 3rem; margin-bottom: 1rem; }
</style>
{% endblock %}

{% block body %}
<div class="ar-hero">
    <div style="position:relative; display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:1rem;">
        <div>
            <div class="ar-hero-title">🔍 Behavioural Anomaly Report</div>
            <div class="ar-hero-sub">Users with suspicious activity patterns detected in the last 7 days</div>
        </div>
        <a href="{{ path('admin_ai_dashboard') }}" class="ar-back-btn">← AI Dashboard</a>
    </div>
</div>

<div class="ar-body">
    {% if items is empty %}
        <div class="ar-empty">
            <div class="ar-empty-icon">🛡️</div>
            <div style="color:#f1f5f9; font-size:1.1rem; font-weight:600; margin-bottom:.5rem;">No anomalies detected</div>
            <div>All recent user behaviour is within normal parameters.</div>
        </div>
    {% else %}
        <div style="margin-bottom:1rem; color:#94a3b8; font-size:.9rem;">
            Suspicious accounts
            <span style="display:inline-block; background:rgba(139,92,246,.1); color:#c4b5fd; border:1px solid rgba(139,92,246,.2); border-radius:20px; padding:.2rem .7rem; font-weight:700; margin-left:.4rem;">{{ items|length }}</span>
            — sorted by risk score
        </div>

        <div class="ar-table-wrap">
            <table class="ar-table">
                <thead>
                    <tr>
                        <th>Score</th>
                        <th>User</th>
                        <th>Level</th>
                        <th>Signals</th>
                        <th>Explanation</th>
                        <th>Recommended Action</th>
                    </tr>
                </thead>
                <tbody>
                    {% for item in items %}
                    {% set level = item.anomaly.risk_level %}
                    <tr>
                        <td>
                            <div class="ar-score ar-score-{{ level }}">{{ item.anomaly.risk_score }}</div>
                        </td>
                        <td>
                            <div style="color:#f1f5f9; font-weight:600;">{{ item.user.fullName ?? 'User #' ~ item.user.id }}</div>
                            <div style="font-size:.78rem; color:#64748b;">{{ item.user.email }}</div>
                            {% if item.user.university %}
                            <div style="font-size:.75rem; color:#7dd3fc;">{{ item.user.university }}</div>
                            {% endif %}
                        </td>
                        <td><span class="ar-level-pill ar-level-{{ level }}">{{ level }}</span></td>
                        <td>
                            {% if item.anomaly.signals is not empty %}
                            <ul class="ar-signal-list">
                                {% for signal in item.anomaly.signals %}
                                <li>{{ signal }}</li>
                                {% endfor %}
                            </ul>
                            {% else %}
                            <span style="color:#475569; font-size:.8rem;">No signals</span>
                            {% endif %}
                        </td>
                        <td><div class="ar-expl">{{ item.anomaly.explanation }}</div></td>
                        <td><div class="ar-action">{{ item.anomaly.action }}</div></td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>
{% endblock %}
