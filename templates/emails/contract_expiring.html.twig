{% extends 'emails/_layout.html.twig' %}
{% set recipient_email = user.email %}

{% block body %}
<div style="text-align:center; margin-bottom:28px;">
  <div style="font-size:50px; line-height:1; margin-bottom:14px;">📅</div>
  <h1 style="margin:0 0 8px; font-size:22px; font-weight:800; color:#1a1d2e; font-family:-apple-system,Arial,sans-serif;">Your rental contract is ending soon</h1>
  <span style="display:inline-block; background:#bee3f8; color:#2a69ac; font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.6px; padding:4px 12px; border-radius:20px; font-family:-apple-system,Arial,sans-serif;">{{ daysLeft }} day{{ daysLeft != 1 ? 's' : '' }} remaining</span>
</div>

<p style="margin:0 0 16px; font-size:15px; line-height:1.75; color:#4a5568; font-family:-apple-system,Arial,sans-serif;">Hi <strong style="color:#1a1d2e;">{{ user.fullName }}</strong>,</p>

<p style="margin:0 0 22px; font-size:15px; line-height:1.75; color:#4a5568; font-family:-apple-system,Arial,sans-serif;">
  Your rental contract for <strong style="color:#6c63ff;">"{{ contract.listing.title }}"</strong> ends on <strong style="color:#e53e3e;">{{ contract.endDate|date('d M Y') }}</strong> — in <strong>{{ daysLeft }} day{{ daysLeft != 1 ? 's' : '' }}</strong>. Time to plan your next move.
</p>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:24px; border-radius:14px; overflow:hidden; border:1.5px solid #eaecf2;">
  <tr style="background:linear-gradient(135deg,#f8f7ff,#ebf8ff);">
    <td style="padding:18px 22px;">
      <p style="margin:0 0 4px; font-size:16px; font-weight:800; color:#1a1d2e; font-family:-apple-system,Arial,sans-serif;">{{ contract.listing.title }}</p>
      <p style="margin:0 0 14px; font-size:13px; color:#718096; font-family:-apple-system,Arial,sans-serif;">📍 {{ contract.listing.address }}</p>
      <p style="margin:0; font-size:18px; font-weight:800; color:#6c63ff; font-family:-apple-system,Arial,sans-serif;">{{ contract.monthlyRent }} TND<span style="font-size:12px; font-weight:400; color:#a0aab8;">/mo · ends {{ contract.endDate|date('d M Y') }}</span></p>
    </td>
  </tr>
</table>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:24px;">
  <tr><td style="background:#f0f8ff; border-radius:12px; border-left:4px solid #63b3ed; padding:18px 22px;">
    <p style="margin:0 0 10px; font-size:13px; font-weight:700; color:#2b6cb0; font-family:-apple-system,Arial,sans-serif;">Your options</p>
    <p style="margin:0; font-size:13.5px; color:#4a5568; line-height:1.85; font-family:-apple-system,Arial,sans-serif;">
      🔄 &nbsp;<strong>Renew the contract</strong> — reach out to your landlord from the Messages section.<br>
      🔍 &nbsp;<strong>Find a new place</strong> — browse available listings from your dashboard.<br>
      🤝 &nbsp;<strong>Find roommates</strong> — use AI matching to find a shared arrangement.<br>
      📋 &nbsp;<strong>Request early termination</strong> — if you need to leave before the end date.
    </p>
  </td></tr>
</table>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
  <tr><td style="background:linear-gradient(135deg,#5b52e0,#3cbfb8); border-radius:14px; padding:18px 24px; text-align:center;">
    <p style="margin:0; font-size:15px; font-weight:700; color:#ffffff; font-family:-apple-system,Arial,sans-serif;">Sign in to your UNIDAR dashboard to take action</p>
  </td></tr>
</table>
{% endblock %}
