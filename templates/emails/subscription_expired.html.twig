{% extends 'emails/_layout.html.twig' %}
{% set recipient_email = user.email %}

{% block body %}
<div style="text-align:center; margin-bottom:28px;">
  <div style="font-size:50px; line-height:1; margin-bottom:14px;">⏰</div>
  <h1 style="margin:0 0 8px; font-size:22px; font-weight:800; color:#1a1d2e; font-family:-apple-system,Arial,sans-serif;">Your subscription has expired</h1>
  <span style="display:inline-block; background:#fed7d7; color:#9b2c2c; font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.6px; padding:4px 12px; border-radius:20px; font-family:-apple-system,Arial,sans-serif;">Expired</span>
</div>

<p style="margin:0 0 16px; font-size:15px; line-height:1.75; color:#4a5568; font-family:-apple-system,Arial,sans-serif;">Hi <strong style="color:#1a1d2e;">{{ user.fullName }}</strong>,</p>

<p style="margin:0 0 20px; font-size:15px; line-height:1.75; color:#4a5568; font-family:-apple-system,Arial,sans-serif;">
  Your <strong>UNIDAR {{ subscription.plan is not null ? subscription.plan.value|capitalize : 'Premium' }}</strong> subscription expired on <strong style="color:#e53e3e;">{{ subscription.expiresAt|date('d M Y') }}</strong>. Your account has been switched to the free plan.
</p>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:24px;">
  <tr><td style="background:#fff5f5; border-radius:12px; border-left:4px solid #e53e3e; padding:18px 22px;">
    <p style="margin:0 0 10px; font-size:13px; font-weight:700; color:#9b2c2c; text-transform:uppercase; letter-spacing:.5px; font-family:-apple-system,Arial,sans-serif;">Features now unavailable</p>
    <p style="margin:0; font-size:13.5px; color:#744210; line-height:1.8; font-family:-apple-system,Arial,sans-serif;">
      ✗ &nbsp;Direct messaging with landlords &amp; students<br>
      ✗ &nbsp;Digital contract generation &amp; signing<br>
      ✗ &nbsp;Advanced AI roommate matching<br>
      ✗ &nbsp;Priority listing visibility
    </p>
  </td></tr>
</table>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:28px; border-radius:12px; overflow:hidden; border:1.5px solid #e8ecf2;">
  <tr style="background:linear-gradient(135deg,#6c63ff,#4ecdc4);">
    <td style="padding:12px 18px; font-size:11px; font-weight:700; color:rgba(255,255,255,.85); text-transform:uppercase; letter-spacing:.8px; font-family:-apple-system,Arial,sans-serif;" width="40%">Plan</td>
    <td style="padding:12px 18px; font-size:11px; font-weight:700; color:rgba(255,255,255,.85); text-transform:uppercase; letter-spacing:.8px; font-family:-apple-system,Arial,sans-serif;" width="30%">Price</td>
    <td style="padding:12px 18px; font-size:11px; font-weight:700; color:rgba(255,255,255,.85); text-transform:uppercase; letter-spacing:.8px; font-family:-apple-system,Arial,sans-serif;">Savings</td>
  </tr>
  <tr style="background:#ffffff; border-top:1px solid #eaecf2;">
    <td style="padding:13px 18px; font-size:14px; font-weight:700; color:#6c63ff; font-family:-apple-system,Arial,sans-serif;">⚡ Monthly</td>
    <td style="padding:13px 18px; font-size:14px; color:#1a1d2e; font-weight:600; font-family:-apple-system,Arial,sans-serif;">29 TND</td>
    <td style="padding:13px 18px; font-size:13px; color:#718096; font-family:-apple-system,Arial,sans-serif;">—</td>
  </tr>
  <tr style="background:#fafbff; border-top:1px solid #eaecf2;">
    <td style="padding:13px 18px; font-size:14px; font-weight:700; color:#4ecdc4; font-family:-apple-system,Arial,sans-serif;">🚀 Yearly</td>
    <td style="padding:13px 18px; font-size:14px; color:#1a1d2e; font-weight:600; font-family:-apple-system,Arial,sans-serif;">249 TND</td>
    <td style="padding:13px 18px; font-size:13px; color:#38a169; font-weight:600; font-family:-apple-system,Arial,sans-serif;">Save 28%</td>
  </tr>
</table>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
  <tr><td style="background:linear-gradient(135deg,#5b52e0,#3cbfb8); border-radius:14px; padding:18px 24px; text-align:center;">
    <p style="margin:0; font-size:15px; font-weight:700; color:#ffffff; font-family:-apple-system,Arial,sans-serif;">Sign in → Subscription → Renew to restore full access</p>
    <p style="margin:8px 0 0; font-size:12px; color:rgba(255,255,255,.7); font-family:-apple-system,Arial,sans-serif;">Cancel anytime · Secure payment</p>
  </td></tr>
</table>
{% endblock %}
