{% extends 'emails/_layout.html.twig' %}
{% set recipient_email = recipient.email %}

{% block body %}
<div style="text-align:center; margin-bottom:28px;">
  <div style="font-size:50px; line-height:1; margin-bottom:14px;">💬</div>
  <h1 style="margin:0 0 8px; font-size:22px; font-weight:800; color:#1a1d2e; font-family:-apple-system,Arial,sans-serif;">You have a new message</h1>
  <p style="margin:0; font-size:14px; color:#718096; font-family:-apple-system,Arial,sans-serif;">from <strong style="color:#6c63ff;">{{ sender.fullName }}</strong></p>
</div>

<p style="margin:0 0 20px; font-size:15px; line-height:1.75; color:#4a5568; font-family:-apple-system,Arial,sans-serif;">Hi <strong style="color:#1a1d2e;">{{ recipient.fullName }}</strong>,</p>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:28px;">
  <tr>
    <td>
      <table role="presentation" cellpadding="0" cellspacing="0" border="0">
        <tr>
          <td style="vertical-align:top; width:46px;">
            <div style="width:42px; height:42px; border-radius:50%; background:linear-gradient(135deg,#6c63ff,#4ecdc4); text-align:center; line-height:42px; font-size:17px; font-weight:800; color:white; font-family:-apple-system,Arial,sans-serif;">{{ sender.fullName|first|upper }}</div>
          </td>
          <td style="padding-left:12px; vertical-align:top;">
            <p style="margin:0 0 4px; font-size:13px; font-weight:700; color:#1a1d2e; font-family:-apple-system,Arial,sans-serif;">{{ sender.fullName }}</p>
            <p style="margin:0 0 8px; font-size:11px; color:#a0aab8; font-family:-apple-system,Arial,sans-serif;">Just now</p>
            <div style="background:#f3f2ff; border-radius:0 14px 14px 14px; padding:14px 18px; max-width:380px;">
              <p style="margin:0; font-size:14.5px; color:#3d3a6b; line-height:1.65; font-family:-apple-system,Arial,sans-serif; font-style:italic;">"{{ messagePreview }}"</p>
            </div>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>

{% if listing is defined and listing %}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:24px;">
  <tr><td style="background:#f7f8fc; border-radius:10px; border:1px solid #eaecf2; padding:14px 18px;">
    <p style="margin:0 0 2px; font-size:11px; color:#a0aab8; text-transform:uppercase; letter-spacing:.5px; font-family:-apple-system,Arial,sans-serif;">About listing</p>
    <p style="margin:0; font-size:14px; font-weight:700; color:#1a1d2e; font-family:-apple-system,Arial,sans-serif;">🏠 {{ listing.title }}</p>
    <p style="margin:2px 0 0; font-size:13px; color:#718096; font-family:-apple-system,Arial,sans-serif;">{{ listing.price }} TND/mo · {{ listing.address }}</p>
  </td></tr>
</table>
{% endif %}

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
  <tr><td style="background:linear-gradient(135deg,#5b52e0,#3cbfb8); border-radius:14px; padding:18px 24px; text-align:center;">
    <p style="margin:0; font-size:15px; font-weight:700; color:#ffffff; font-family:-apple-system,Arial,sans-serif;">Sign in → Messages → Reply to {{ sender.fullName|split(' ')|first }}</p>
  </td></tr>
</table>
{% endblock %}
