{% extends 'emails/_layout.html.twig' %}
{% set recipient_email = recipient.email %}

{% block body %}
<div style="text-align:center; margin-bottom:28px;">
  <div style="font-size:50px; line-height:1; margin-bottom:14px;">📋</div>
  <h1 style="margin:0 0 8px; font-size:22px; font-weight:800; color:#1a1d2e; font-family:-apple-system,Arial,sans-serif;">Contract termination request</h1>
  <span style="display:inline-block; background:#fefcbf; color:#7b6c0b; font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.6px; padding:4px 12px; border-radius:20px; font-family:-apple-system,Arial,sans-serif;">Action required</span>
</div>

<p style="margin:0 0 16px; font-size:15px; line-height:1.75; color:#4a5568; font-family:-apple-system,Arial,sans-serif;">Hi <strong style="color:#1a1d2e;">{{ recipient.fullName }}</strong>,</p>

{% if recipient_role == 'owner' %}
<p style="margin:0 0 20px; font-size:15px; line-height:1.75; color:#4a5568; font-family:-apple-system,Arial,sans-serif;">
  <strong style="color:#1a1d2e;">{{ requester.fullName }}</strong> has submitted a request to <strong>terminate their rental contract</strong> early. Please review it from your dashboard.
</p>
{% else %}
<p style="margin:0 0 20px; font-size:15px; line-height:1.75; color:#4a5568; font-family:-apple-system,Arial,sans-serif;">
  Your termination request for contract <strong style="color:#6c63ff;">#{{ contract.contractNumber }}</strong> has been submitted and is awaiting review by the property owner.
</p>
{% endif %}

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:22px; border-radius:12px; overflow:hidden; border:1px solid #eaecf2;">
  <tr style="background:#f7f8fc;">
    <td colspan="2" style="padding:13px 18px; font-size:12px; font-weight:700; color:#718096; text-transform:uppercase; letter-spacing:.6px; font-family:-apple-system,Arial,sans-serif;">Contract details</td>
  </tr>
  <tr style="border-top:1px solid #eaecf2;">
    <td style="padding:11px 18px; font-size:13px; color:#718096; font-family:-apple-system,Arial,sans-serif; width:45%;">Contract #</td>
    <td style="padding:11px 18px; font-size:13px; font-weight:600; color:#1a1d2e; font-family:-apple-system,Arial,sans-serif;">{{ contract.contractNumber }}</td>
  </tr>
  <tr style="border-top:1px solid #eaecf2; background:#fafbff;">
    <td style="padding:11px 18px; font-size:13px; color:#718096; font-family:-apple-system,Arial,sans-serif;">Property</td>
    <td style="padding:11px 18px; font-size:13px; font-weight:600; color:#1a1d2e; font-family:-apple-system,Arial,sans-serif;">{{ contract.listing.title }}</td>
  </tr>
  <tr style="border-top:1px solid #eaecf2;">
    <td style="padding:11px 18px; font-size:13px; color:#718096; font-family:-apple-system,Arial,sans-serif;">Contract end date</td>
    <td style="padding:11px 18px; font-size:13px; font-weight:600; color:#1a1d2e; font-family:-apple-system,Arial,sans-serif;">{{ contract.endDate|date('d M Y') }}</td>
  </tr>
  <tr style="border-top:1px solid #eaecf2; background:#fafbff;">
    <td style="padding:11px 18px; font-size:13px; color:#718096; font-family:-apple-system,Arial,sans-serif;">Monthly rent</td>
    <td style="padding:11px 18px; font-size:13px; font-weight:600; color:#1a1d2e; font-family:-apple-system,Arial,sans-serif;">{{ contract.monthlyRent }} TND</td>
  </tr>
  <tr style="border-top:1px solid #eaecf2;">
    <td style="padding:11px 18px; font-size:13px; color:#718096; font-family:-apple-system,Arial,sans-serif;">Requested on</td>
    <td style="padding:11px 18px; font-size:13px; font-weight:600; color:#1a1d2e; font-family:-apple-system,Arial,sans-serif;">{{ request.createdAt|date('d M Y') }}</td>
  </tr>
</table>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:24px;">
  <tr><td style="background:#fffbeb; border-radius:12px; border-left:4px solid #d69e2e; padding:18px 22px;">
    <p style="margin:0 0 6px; font-size:12px; font-weight:700; color:#b7791f; text-transform:uppercase; letter-spacing:.5px; font-family:-apple-system,Arial,sans-serif;">Reason provided</p>
    <p style="margin:0; font-size:14px; color:#744210; line-height:1.65; font-family:-apple-system,Arial,sans-serif; font-style:italic;">"{{ request.reason }}"</p>
  </td></tr>
</table>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
  <tr><td style="background:linear-gradient(135deg,#5b52e0,#3cbfb8); border-radius:14px; padding:18px 24px; text-align:center;">
    {% if recipient_role == 'owner' %}
    <p style="margin:0; font-size:15px; font-weight:700; color:#ffffff; font-family:-apple-system,Arial,sans-serif;">Sign in → My Contracts → Review &amp; respond to this request</p>
    {% else %}
    <p style="margin:0; font-size:15px; font-weight:700; color:#ffffff; font-family:-apple-system,Arial,sans-serif;">Sign in → My Contracts → Track request status</p>
    {% endif %}
  </td></tr>
</table>
{% endblock %}
