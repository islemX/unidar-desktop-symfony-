{% extends 'emails/_layout.html.twig' %}
{% set recipient_email = user.email %}

{% block body %}
<div style="text-align:center; margin-bottom:28px;">
  <div style="font-size:50px; line-height:1; margin-bottom:14px;">💳</div>
  <h1 style="margin:0 0 8px; font-size:22px; font-weight:800; color:#1a1d2e; font-family:-apple-system,Arial,sans-serif;">Rent reminder — {{ daysUntilDue }} day{{ daysUntilDue != 1 ? 's' : '' }} to go</h1>
  <span style="display:inline-block; font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.6px; padding:4px 12px; border-radius:20px; font-family:-apple-system,Arial,sans-serif; {% if daysUntilDue <= 3 %}background:#fed7d7; color:#9b2c2c;{% else %}background:#fefcbf; color:#7b6c0b;{% endif %}">Due {{ dueDate|date('d M Y') }}</span>
</div>

<p style="margin:0 0 16px; font-size:15px; line-height:1.75; color:#4a5568; font-family:-apple-system,Arial,sans-serif;">Hi <strong style="color:#1a1d2e;">{{ user.fullName }}</strong>,</p>
<p style="margin:0 0 22px; font-size:15px; line-height:1.75; color:#4a5568; font-family:-apple-system,Arial,sans-serif;">
  Friendly reminder that your rent for <strong style="color:#6c63ff;">{{ contract.listing.title }}</strong> is due in <strong>{{ daysUntilDue }} day{{ daysUntilDue != 1 ? 's' : '' }}</strong>.
</p>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:24px; border-radius:16px; overflow:hidden;">
  <tr>
    <td style="background:linear-gradient(135deg,#6c63ff,#4ecdc4); padding:28px; text-align:center;">
      <p style="margin:0 0 6px; font-size:12px; color:rgba(255,255,255,.75); text-transform:uppercase; letter-spacing:1.5px; font-family:-apple-system,Arial,sans-serif;">Amount due</p>
      <p style="margin:0; font-size:38px; font-weight:900; color:#ffffff; font-family:-apple-system,Arial,sans-serif; line-height:1;">{{ contract.monthlyRent }} <span style="font-size:18px; font-weight:600; opacity:.8;">TND</span></p>
      <p style="margin:8px 0 0; font-size:13px; color:rgba(255,255,255,.7); font-family:-apple-system,Arial,sans-serif;">Due on {{ dueDate|date('D, d M Y') }}</p>
    </td>
  </tr>
</table>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:24px; border-radius:12px; overflow:hidden; border:1px solid #eaecf2;">
  <tr style="background:#f7f8fc;">
    <td style="padding:11px 18px; font-size:13px; color:#718096; font-family:-apple-system,Arial,sans-serif; width:45%;">Property</td>
    <td style="padding:11px 18px; font-size:13px; font-weight:600; color:#1a1d2e; font-family:-apple-system,Arial,sans-serif;">{{ contract.listing.title }}</td>
  </tr>
  <tr style="border-top:1px solid #eaecf2;">
    <td style="padding:11px 18px; font-size:13px; color:#718096; font-family:-apple-system,Arial,sans-serif;">Contract #</td>
    <td style="padding:11px 18px; font-size:13px; font-weight:600; color:#1a1d2e; font-family:-apple-system,Arial,sans-serif;">{{ contract.contractNumber }}</td>
  </tr>
  <tr style="border-top:1px solid #eaecf2; background:#fafbff;">
    <td style="padding:11px 18px; font-size:13px; color:#718096; font-family:-apple-system,Arial,sans-serif;">Owner</td>
    <td style="padding:11px 18px; font-size:13px; font-weight:600; color:#1a1d2e; font-family:-apple-system,Arial,sans-serif;">{{ contract.owner.fullName }}</td>
  </tr>
</table>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
  <tr><td style="background:#f7f8fc; border-radius:12px; border:1px solid #eaecf2; padding:16px 20px; text-align:center;">
    <p style="margin:0; font-size:13.5px; font-weight:600; color:#4a5568; font-family:-apple-system,Arial,sans-serif;">Sign in → My Contracts → View payment details</p>
    <p style="margin:6px 0 0; font-size:12px; color:#a0aab8; font-family:-apple-system,Arial,sans-serif;">Contact your owner directly if you need to arrange an alternative date.</p>
  </td></tr>
</table>
{% endblock %}
