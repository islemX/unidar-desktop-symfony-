{% extends 'base.html.twig' %}
{% block voice_briefing %}
<script>window.__vcPage__ = { page: 'dashboard_student', role: 'student', briefing: { en: "Student dashboard. Manage your saved listings and contracts. Say 'my contracts' or 'saved listings'.", fr: "Tableau de bord étudiant. Dites 'mes contrats' ou 'favoris'.", ar: "لوحة تحكم الطالب. قل 'عقودي' أو 'المحفوظات'." }, suggestions: [ {label:'My contracts', cmd:'open contracts'}, {label:'Saved listings', cmd:'saved listings'}, {label:'Browse listings', cmd:'open listings'} ] };</script>
{% endblock %}
{% block title %}Dashboard - UNIDAR{% endblock %}

{% block stylesheets %}
<style>
    .dashboard-hero {
        background: linear-gradient(135deg, var(--color-surface-900), #1e1b4b);
        color: white; border-radius: var(--radius-2xl); padding: 2rem; margin-bottom: 2rem;
        position: relative; overflow: hidden;
    }
    .dashboard-hero::before {
        content: ''; position: absolute; top: -50%; right: -20%; width: 300px; height: 300px;
        border-radius: 50%; background: rgba(99,102,241,0.15);
    }
    .dashboard-hero h1 { font-size: 1.75rem; color: white; margin-bottom: 0.5rem; position: relative; z-index: 1; }
    .dashboard-hero p { color: rgba(255,255,255,0.7); position: relative; z-index: 1; }

    /* ── Status notification stack ── */
    .status-stack { display: flex; flex-direction: column; gap: 0.75rem; margin-bottom: 1.5rem; }
    .status-bar {
        position: relative; overflow: hidden;
        display: flex; align-items: center; gap: 1rem;
        padding: 1rem 1.25rem;
        border-radius: var(--radius-xl);
        border: 1px solid transparent;
        background: #fff;
        box-shadow: 0 6px 22px -10px rgba(0,0,0,0.18);
        animation: statusSlide 0.55s cubic-bezier(.2,.8,.2,1) both;
    }
    .status-bar::before {
        content: ''; position: absolute; inset: 0;
        background: linear-gradient(100deg, transparent 30%, rgba(255,255,255,0.55) 50%, transparent 70%);
        transform: translateX(-120%);
        animation: shimmerBar 3.4s ease-in-out infinite;
        pointer-events: none;
    }
    .status-bar .status-icon {
        flex: 0 0 46px; width: 46px; height: 46px;
        display: inline-flex; align-items: center; justify-content: center;
        font-size: 1.25rem; color: #fff;
        border-radius: 14px;
        box-shadow: 0 6px 18px -4px currentColor;
        animation: statusPulse 2.4s ease-in-out infinite;
    }
    .status-bar .status-body { flex: 1 1 auto; min-width: 0; }
    .status-bar .status-title { font-weight: 700; font-size: 0.98rem; margin-bottom: 2px; color: #111827; }
    .status-bar .status-msg { font-size: 0.83rem; color: #4b5563; }
    .status-bar .status-cta {
        flex: 0 0 auto;
        display: inline-flex; align-items: center; gap: 0.4rem;
        padding: 0.55rem 1rem;
        border-radius: 10px;
        font-weight: 700; font-size: 0.82rem;
        text-decoration: none;
        color: #fff;
        background: linear-gradient(135deg, var(--ga,#6366f1), var(--gb,#ec4899));
        box-shadow: 0 8px 20px -6px rgba(0,0,0,0.25);
        transition: transform 0.18s ease, box-shadow 0.18s ease;
    }
    .status-bar .status-cta:hover { transform: translateY(-2px); box-shadow: 0 12px 26px -8px rgba(0,0,0,0.3); }

    .status-bar--danger  { --ga:#ef4444; --gb:#f97316; border-color:#fecaca; background:linear-gradient(100deg,#fff5f5,#fff); }
    .status-bar--danger  .status-icon { background:linear-gradient(135deg,#ef4444,#f97316); color:#ef4444; }
    .status-bar--warn    { --ga:#f59e0b; --gb:#ef4444; border-color:#fde68a; background:linear-gradient(100deg,#fffaf0,#fff); }
    .status-bar--warn    .status-icon { background:linear-gradient(135deg,#f59e0b,#f97316); color:#f59e0b; }
    .status-bar--info    { --ga:#6366f1; --gb:#8b5cf6; border-color:#c7d2fe; background:linear-gradient(100deg,#eef2ff,#fff); }
    .status-bar--info    .status-icon { background:linear-gradient(135deg,#6366f1,#8b5cf6); color:#6366f1; }

    @keyframes statusSlide {
        from { opacity:0; transform: translateY(-8px) scale(0.98); }
        to   { opacity:1; transform: translateY(0) scale(1); }
    }
    @keyframes shimmerBar {
        0%, 10% { transform: translateX(-120%); }
        45%, 100% { transform: translateX(120%); }
    }
    @keyframes statusPulse {
        0%,100% { transform: scale(1); box-shadow: 0 6px 18px -4px currentColor; }
        50%     { transform: scale(1.06); box-shadow: 0 10px 26px -4px currentColor; }
    }

    @media (prefers-reduced-motion: reduce) {
        .status-bar, .status-bar::before, .status-bar .status-icon { animation: none !important; }
    }
    @media (max-width: 640px) {
        .status-bar { flex-wrap: wrap; }
        .status-bar .status-cta { width: 100%; justify-content: center; }
    }
</style>
{% endblock %}

{% block body %}
<div class="floating-shapes"><div class="shape shape-1"></div><div class="shape shape-2"></div></div>

<main class="section" style="padding: 2.5rem 0;">
    <div class="container">
        <!-- Hero -->
        <div class="dashboard-hero fade-in-up">
            <h1>Welcome back, {{ app.user.fullName }}!</h1>
            <p>Here's your UNIDAR activity at a glance.</p>
        </div>

        {# ── Account-health notification bar ── #}
        {% if (not is_verified) or (not has_subscription) %}
            <div class="status-stack fade-in-up">
                {% if not is_verified %}
                    {% set vstyle = verification_status == 'rejected' ? 'danger' : (verification_status == 'pending' ? 'info' : 'warn') %}
                    <div class="status-bar status-bar--{{ vstyle }}">
                        <span class="status-icon">
                            {% if verification_status == 'rejected' %}❌
                            {% elseif verification_status == 'pending' %}⏳
                            {% else %}🪪
                            {% endif %}
                        </span>
                        <div class="status-body">
                            <div class="status-title">
                                {% if verification_status == 'rejected' %}
                                    Your verification was rejected
                                {% elseif verification_status == 'pending' %}
                                    Verification under review
                                {% else %}
                                    Verify your identity to unlock UNIDAR
                                {% endif %}
                            </div>
                            <div class="status-msg">
                                {% if verification_status == 'rejected' %}
                                    Our team couldn't validate your documents. Please re-submit a clearer copy of your student ID and national ID.
                                {% elseif verification_status == 'pending' %}
                                    Our team is reviewing your documents — this usually takes less than 24 hours. You'll be notified once approved.
                                {% else %}
                                    Upload your student ID and national ID so owners know they're dealing with a real student.
                                {% endif %}
                            </div>
                        </div>
                        {% if verification_status != 'pending' %}
                            <a href="{{ path('verification_submit') }}" class="status-cta">
                                {{ verification_status == 'rejected' ? 'Re-submit' : 'Verify now' }} →
                            </a>
                        {% endif %}
                    </div>
                {% endif %}

                {% if not has_subscription %}
                    <div class="status-bar status-bar--warn">
                        <span class="status-icon">⭐</span>
                        <div class="status-body">
                            <div class="status-title">A subscription is required to rent on UNIDAR</div>
                            <div class="status-msg">
                                Without an active subscription you <strong>can't generate a contract</strong> or
                                <strong>message owners and potential roommates</strong>. Pick a plan to unlock everything.
                            </div>
                        </div>
                        <a href="{{ path('subscription_index') }}" class="status-cta">Subscribe →</a>
                    </div>
                {% endif %}
            </div>
        {% endif %}

        <!-- Stats row -->
        <div class="grid grid-3 fade-in-up stagger-1" style="margin-bottom: 2rem;">
            <div class="stat-card">
                <h3>{{ active_contracts_count }}</h3>
                <p>Active Contracts</p>
            </div>
            <div class="stat-card" style="background: linear-gradient(135deg, var(--secondary), #00b5b0);">
                <h3>{{ unread_count }}</h3>
                <p>Unread Messages</p>
            </div>
            <div class="stat-card" style="background: linear-gradient(135deg, var(--accent), #e84393);">
                <h3>{{ saved_count }}</h3>
                <p>Saved Listings</p>
            </div>
        </div>

        <!-- Two-column grid -->
        <div class="grid grid-2 fade-in-up stagger-2">
            <!-- Quick Actions -->
            <div class="card premium-card" style="padding: 0; overflow: hidden;">
                <div class="card-header" style="padding: 1.25rem 1.5rem;">
                    <h3 style="font-size: 1rem; margin: 0;">Quick Actions</h3>
                </div>
                <div style="padding: 1.5rem; display: flex; flex-direction: column; gap: 0.75rem;">
                    <a href="{{ path('listing_index') }}" class="btn btn-primary hover-lift">🔍 Browse Listings</a>
                    <a href="{{ path('roommate_index') }}" class="btn btn-secondary hover-lift">🤝 Find Roommates</a>
                    <button type="button" class="btn btn-secondary hover-lift" onclick="if(window.chatWidget){chatWidget.toggle(true)}">💬 Messages{% if unread_count > 0 %} <span class="badge badge-danger" style="margin-left: 0.5rem;">{{ unread_count }}</span>{% endif %}</button>
                    <a href="{{ path('verification_submit') }}" class="btn btn-secondary hover-lift">🪪 Verification</a>
                    <a href="{{ path('subscription_index') }}" class="btn btn-secondary hover-lift">⭐ Subscription</a>
                </div>
            </div>

            <!-- My Contracts -->
            <div class="card premium-card" style="padding: 0; overflow: hidden;">
                <div class="card-header" style="padding: 1.25rem 1.5rem; display: flex; justify-content: space-between; align-items: center;">
                    <h3 style="font-size: 1rem; margin: 0;">My Contracts</h3>
                    <a href="{{ path('contract_index') }}" style="font-size: 0.82rem; color: var(--color-brand); font-weight: 600;">View All →</a>
                </div>
                <div style="padding: 1.5rem;">
                    {% if contracts|length == 0 %}
                        <div class="text-center" style="padding: 2rem 0; color: var(--color-text-muted);">
                            <div style="font-size: 2rem; margin-bottom: 0.5rem;">📄</div>
                            <p>No contracts yet.</p>
                        </div>
                    {% else %}
                        {% for contract in contracts|slice(0, 5) %}
                        <div style="display: flex; justify-content: space-between; align-items: center; padding: 0.875rem 0; border-bottom: 1px solid var(--color-surface-100);">
                            <div>
                                <div style="font-size: 0.9rem; font-weight: 600;">{{ contract.listing.title }}</div>
                                <div style="font-size: 0.8rem; color: var(--color-text-muted);">{{ contract.monthlyRent }} TND/mo</div>
                            </div>
                            <div style="display: flex; align-items: center; gap: 0.5rem;">
                                <span class="badge {% if contract.status.value == 'active' %}badge-success{% elseif contract.status.value == 'signed_by_both' %}badge-info{% elseif contract.status.value == 'cancelled' %}badge-danger{% else %}badge-warning{% endif %}">
                                    {{ contract.status.value|replace({'_': ' '})|title }}
                                </span>
                                {% if contract.status.value != 'cancelled' %}
                                    <a href="{{ path('contract_show', {id: contract.id}) }}" class="btn btn-secondary btn-sm">View</a>
                                {% else %}
                                    <span class="btn btn-sm" style="opacity:0.5;cursor:not-allowed;" title="Contract cancelled">Unavailable</span>
                                {% endif %}
                            </div>
                        </div>
                        {% endfor %}
                    {% endif %}
                </div>
            </div>
        </div>

        <!-- AI Roommate Suggestions -->
        <div class="card premium-card fade-in-up stagger-3" style="padding:0;overflow:hidden;margin-top:2rem;">
            <div class="card-header" style="padding:1.25rem 1.5rem;display:flex;justify-content:space-between;align-items:center;">
                <h3 style="font-size:1rem;margin:0;">🤖 AI Roommate Suggestions</h3>
                <a href="{{ path('roommate_index') }}" style="font-size:0.82rem;color:var(--color-brand);font-weight:600;">View All →</a>
            </div>
            <div style="padding:1.5rem;" id="dashboardRoommateBox">
                <div style="display:flex;align-items:center;gap:0.75rem;color:var(--color-text-muted);font-size:0.9rem;">
                    <span style="font-size:1.5rem;">⏳</span>
                    <span>Loading your best roommate matches…</span>
                </div>
            </div>
        </div>

        <!-- AI Cost of Living Intelligence -->
        <div class="fade-in-up" style="margin-top:2rem;">
            <div style="background:linear-gradient(135deg,#1e1b4b,#312e81);border-radius:var(--radius-2xl);padding:1.75rem 2rem;position:relative;overflow:hidden;color:white;">
                <div style="position:absolute;top:-40px;right:-40px;width:180px;height:180px;border-radius:50%;background:rgba(99,102,241,0.2);pointer-events:none;"></div>
                <div style="position:absolute;bottom:-30px;left:60%;width:120px;height:120px;border-radius:50%;background:rgba(168,85,247,0.15);pointer-events:none;"></div>
                <div style="position:relative;z-index:1;">
                    <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:1rem;flex-wrap:wrap;gap:0.5rem;">
                        <div>
                            <div style="font-size:0.75rem;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;opacity:0.7;margin-bottom:0.25rem;">AI Finance Intelligence</div>
                            <h3 style="margin:0;font-size:1.2rem;color:white;">🏦 Monthly Cost of Living</h3>
                        </div>
                        <div id="colTotalBadge" style="background:rgba(255,255,255,0.15);backdrop-filter:blur(8px);padding:8px 18px;border-radius:50px;font-weight:800;font-size:1.1rem;border:1px solid rgba(255,255,255,0.2);">
                            Loading…
                        </div>
                    </div>
                    <div id="colDashGrid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:0.6rem;">
                        <div style="background:rgba(255,255,255,0.08);border-radius:12px;padding:0.75rem;text-align:center;font-size:0.8rem;opacity:0.6;">
                            <div style="font-size:1.2rem;margin-bottom:4px;">⏳</div>
                            Loading breakdown…
                        </div>
                    </div>
                    <p style="font-size:0.76rem;opacity:0.6;margin:0.75rem 0 0;">Estimates based on your saved listings area. Actual costs may vary.</p>
                </div>
            </div>
        </div>

        <!-- AI Re-engagement (Churn Prevention) -->
        <div id="churnBanner" style="display:none;margin-top:1.25rem;">
            <div style="background:linear-gradient(135deg,#fff7ed,#fffbeb);border:1px solid #fed7aa;border-radius:var(--radius-xl);padding:1.25rem 1.5rem;display:flex;align-items:center;gap:1rem;flex-wrap:wrap;">
                <div style="width:46px;height:46px;border-radius:14px;background:linear-gradient(135deg,#f59e0b,#ef4444);display:flex;align-items:center;justify-content:center;font-size:1.2rem;flex-shrink:0;">🎯</div>
                <div style="flex:1;min-width:200px;">
                    <div style="font-weight:700;font-size:0.95rem;color:#92400e;" id="churnTitle">We miss you!</div>
                    <div style="font-size:0.83rem;color:#78350f;margin-top:2px;" id="churnMsg">Pick up where you left off — great listings are waiting.</div>
                </div>
                <a href="{{ path('listing_index') }}" class="btn btn-primary" style="background:linear-gradient(135deg,#f59e0b,#ef4444);border:none;padding:10px 20px;font-size:0.85rem;white-space:nowrap;">Browse Now →</a>
            </div>
        </div>
    </div>
</main>
{% endblock %}

{% block javascripts %}
<script>
// ── Cost of Living Dashboard Widget ─────────────────────────────────────────
(function() {
    function renderCOL(d) {
        var total     = d.total_monthly || 0;
        var breakdown = d.breakdown || {};
        var icons     = { rent:'🏠', utilities:'⚡', internet:'📶', transport:'🚌', groceries:'🛒', extras:'🎯' };
        document.getElementById('colTotalBadge').textContent = '~' + total + ' TND/mo';
        var grid = document.getElementById('colDashGrid');
        var html = '';
        Object.entries(breakdown).forEach(function([k, v]) {
            var icon = icons[k] || '📌';
            html += '<div style="background:rgba(255,255,255,0.1);border-radius:12px;padding:0.75rem;text-align:center;">';
            html += '<div style="font-size:1.1rem;margin-bottom:4px;">' + icon + '</div>';
            html += '<div style="font-size:0.7rem;opacity:0.75;text-transform:capitalize;">' + k + '</div>';
            html += '<div style="font-weight:800;font-size:0.95rem;margin-top:2px;">' + v + ' TND</div>';
            html += '</div>';
        });
        if (html) grid.innerHTML = html;
    }

    function showFallback() {
        renderCOL({ total_monthly: 950, breakdown: { rent:600, utilities:90, internet:40, transport:80, groceries:100, extras:40 } });
    }

    fetch('/api/ai/user/{{ app.user.id }}/cost-of-living', { credentials: 'same-origin' })
        .then(function(r) { return r.ok ? r.json() : Promise.reject(r.status); })
        .then(function(d) { renderCOL(d); })
        .catch(function() { showFallback(); });
})();

// ── Churn Re-engagement Banner ───────────────────────────────────────────────
(function() {
    fetch('/api/ai/user/{{ app.user.id }}/churn', { credentials: 'same-origin' })
        .then(function(r) { return r.ok ? r.json() : null; })
        .then(function(d) {
            if (!d || d.risk_score === undefined) return;
            var score = d.risk_score || 0;
            // Show banner only if churn risk is medium-high (>= 45)
            if (score < 45) return;
            var banner = document.getElementById('churnBanner');
            var title  = document.getElementById('churnTitle');
            var msg    = document.getElementById('churnMsg');
            if (score >= 75) {
                title.textContent = "🚨 We haven't seen you in a while!";
                msg.textContent = d.message || "Your saved listings may no longer be available. Check now before they're gone.";
            } else {
                title.textContent = "👋 Ready to continue your search?";
                msg.textContent = d.message || "You have unfinished business — great listings are waiting for you.";
            }
            banner.style.display = 'block';
        })
        .catch(function(){});
})();

// ── Roommate Suggestions ─────────────────────────────────────────────────────
(function() {
    fetch('/api/roommate-matches?limit=3', { credentials: 'same-origin' })
        .then(function(r) { return r.ok ? r.json() : null; })
        .then(function(payload) {
            var box = document.getElementById('dashboardRoommateBox');
            if (!box) return;
            var data = payload && payload.matches ? payload.matches : [];
            if (!data.length) {
                box.innerHTML = '<div style="text-align:center;padding:1.5rem;color:var(--color-text-muted);">'
                    + '<div style="font-size:2rem;margin-bottom:0.5rem;">🤝</div>'
                    + '<p>Set your roommate preferences to see AI-powered matches.</p>'
                    + '<a href="{{ path("roommate_index") }}" class="btn btn-primary" style="margin-top:0.75rem;">Set Preferences</a></div>';
                return;
            }
            var html = '<div style="display:flex;flex-direction:column;gap:0.75rem;">';
            data.forEach(function(m) {
                var score = m.compatibility_score || 0;
                var color = score >= 80 ? '#10b981' : score >= 55 ? '#f59e0b' : '#6366f1';
                var name  = (m.user && m.user.full_name) ? m.user.full_name : 'Student';
                var uni   = (m.user && m.user.university) ? m.user.university : null;
                html += '<div style="display:flex;align-items:center;gap:0.75rem;padding:0.75rem;background:var(--color-surface-50);border-radius:var(--radius-lg);">';
                html += '<div style="width:42px;height:42px;border-radius:50%;background:linear-gradient(135deg,var(--color-brand),#4f46e5);color:white;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:1rem;flex-shrink:0;">'
                    + name.charAt(0).toUpperCase() + '</div>';
                html += '<div style="flex:1;min-width:0;">';
                html += '<div style="font-weight:600;font-size:0.9rem;">' + name + '</div>';
                if (uni) { html += '<div style="font-size:0.78rem;color:var(--color-text-muted);">🎓 ' + uni + '</div>'; }
                html += '</div>';
                html += '<div style="font-size:1rem;font-weight:800;color:' + color + ';">' + score + '%</div>';
                html += '</div>';
            });
            html += '</div>';
            html += '<a href="{{ path("roommate_index") }}" class="btn btn-secondary" style="width:100%;margin-top:1rem;font-size:0.85rem;">See all matches</a>';
            box.innerHTML = html;
        })
        .catch(function() {
            var box = document.getElementById('dashboardRoommateBox');
            if (box) box.innerHTML = '<p style="color:var(--color-text-muted);font-size:0.85rem;">Could not load roommate suggestions.</p>';
        });
})();
</script>
{% endblock %}

