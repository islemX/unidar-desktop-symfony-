            { name: 'ISSAT Sidi Bouzid', city: 'Sidi Bouzid', address: 'Route de Gafsa, Sidi Bouzid', latitude: 35.0380, longitude: 9.4840 },
            // ── Siliana ──────────────────────────────────────────────────────────
            { name: 'ISSS – Institut Supérieur de Siliana', city: 'Siliana', address: 'Siliana', latitude: 36.0850, longitude: 9.3714 },
