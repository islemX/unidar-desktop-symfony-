            { name: 'Université de Bizerte', city: 'Bizerte', address: 'Zarzouna, Bizerte', latitude: 37.2744, longitude: 9.8739 },
            { name: 'ENIB – École Nationale d\'Ingénieurs de Bizerte', city: 'Bizerte', address: 'Bizerte', latitude: 37.2744, longitude: 9.8739 },
            { name: 'ISET de Bizerte', city: 'Bizerte', address: 'Zarzouna, Bizerte', latitude: 37.2744, longitude: 9.8739 },
            // ── Jendouba ─────────────────────────────────────────────────────────
            { name: 'Université de Jendouba', city: 'Jendouba', address: 'Avenue du 7 Novembre, Jendouba', latitude: 36.5011, longitude: 8.7757 },
            { name: 'ISSABT – Institut Supérieur des Sciences Appliquées et de Technologie de Béja', city: 'Béja', address: 'Béja', latitude: 36.7333, longitude: 9.1833 },
            // ── Kairouan ─────────────────────────────────────────────────────────
            { name: 'Université de Kairouan', city: 'Kairouan', address: 'Avenue Zama El Balaoui, Kairouan', latitude: 35.6784, longitude: 10.1013 },
            { name: 'ISSAT Kairouan', city: 'Kairouan', address: 'Route Tunis km 5, Kairouan', latitude: 35.6764, longitude: 10.0943 },
            { name: 'ISSIG – Institut Supérieur d\'Informatique et de Gestion de Kairouan', city: 'Kairouan', address: 'Kairouan', latitude: 35.6784, longitude: 10.1013 },
            // ── Gafsa ────────────────────────────────────────────────────────────
            { name: 'Université de Gafsa', city: 'Gafsa', address: 'Campus Universitaire Sidi Ahmed Zarroug, Gafsa', latitude: 34.4200, longitude: 8.7843 },
            { name: 'ISSAT Gafsa', city: 'Gafsa', address: 'Gafsa', latitude: 34.4200, longitude: 8.7843 },
            // ── Kasserine ────────────────────────────────────────────────────────
            { name: 'ISSAT Kasserine', city: 'Kasserine', address: 'Route de Sbiba, Kasserine', latitude: 35.1675, longitude: 8.8365 },
            // ── Le Kef ───────────────────────────────────────────────────────────
            { name: 'Université du Kef', city: 'Le Kef', address: 'Le Kef', latitude: 36.1825, longitude: 8.7147 },
            { name: 'ISSAT Kef', city: 'Le Kef', address: 'Le Kef', latitude: 36.1825, longitude: 8.7147 },
            // ── Nabeul / Cap Bon ─────────────────────────────────────────────────
            { name: 'IPEIN – Institut Préparatoire aux Études d\'Ingénieur de Nabeul', city: 'Nabeul', address: 'Nabeul', latitude: 36.4513, longitude: 10.7357 },
            { name: 'ISET de Nabeul', city: 'Nabeul', address: 'Nabeul', latitude: 36.4513, longitude: 10.7357 },
