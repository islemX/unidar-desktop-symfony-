        // ── End dataset ──────────────────────────────────────────────────────────

        var debounceTimer = null;
        var activeIndex   = -1;
        var currentResults = [];

        uniSearch.addEventListener('input', function () {
            clearTimeout(debounceTimer);
            var q = this.value.trim();
            if (q.length < 2) { closeDropdown(); return; }
            debounceTimer = setTimeout(function () { fetchSuggestions(q); }, 150);
        });

        uniSearch.addEventListener('keydown', function (e) {
            var items = uniDropdown.querySelectorAll('.uni-suggestion-item');
            if (!items.length) return;
            if (e.key === 'ArrowDown') {
                e.preventDefault();
                activeIndex = Math.min(activeIndex + 1, items.length - 1);
                highlightItem(items);
            } else if (e.key === 'ArrowUp') {
                e.preventDefault();
                activeIndex = Math.max(activeIndex - 1, 0);
                highlightItem(items);
            } else if (e.key === 'Enter' && activeIndex >= 0) {
                e.preventDefault();
                selectFaculty(currentResults[activeIndex]);
            } else if (e.key === 'Escape') {
                closeDropdown();
            }
        });

        document.addEventListener('click', function (e) {
            if (!uniSearch.contains(e.target) && !uniDropdown.contains(e.target)) {
                closeDropdown();
            }
        });

        function fetchSuggestions(q) {
            var qLow = q.toLowerCase().replace(/[-–—]/g, ' ');
            // 1️⃣ Search local dataset first — instant, works offline
            var local = UNIVERSITIES.filter(function (u) {
                var haystack = (u.name + ' ' + u.city + ' ' + (u.address || '')).toLowerCase();
                // Support multi-word queries: every word must match somewhere
                return qLow.split(/\s+/).every(function (word) {
                    return word.length === 0 || haystack.indexOf(word) !== -1;
                });
            }).slice(0, 8);

            if (local.length > 0) {
                currentResults = local;
                renderDropdown(local);
            } else {
                // 2️⃣ Fallback to Nominatim for unlisted / custom names
                fetchNominatim(q);
            }
        }

        function fetchNominatim(q) {
            var url = 'https://nominatim.openstreetmap.org/search?format=json&limit=6&addressdetails=1'
                    + '&q=' + encodeURIComponent(q + ' université Tunisia')
                    + '&countrycodes=tn';
            fetch(url, { headers: { 'Accept-Language': 'fr,en' } })
                .then(function (r) { return r.json(); })
                .then(function (items) {
                    var results = items.map(function (item) {
                        return {
                            name: item.display_name.split(',')[0],
                            address: item.display_name,
                            latitude: parseFloat(item.lat),
                            longitude: parseFloat(item.lon)
                        };
                    });
                    currentResults = results;
                    renderDropdown(results);
                })
                .catch(function () { closeDropdown(); });
        }

        function renderDropdown(faculties) {
            uniDropdown.innerHTML = '';
            activeIndex = -1;
            if (!faculties.length) { closeDropdown(); return; }

            faculties.forEach(function (f) {
                var item = document.createElement('div');
                item.className = 'uni-suggestion-item';
                // Show city badge when the dataset entry has one
                var cityBadge = f.city
                    ? '<span style="display:inline-block;background:var(--color-primary-50,#eff6ff);color:var(--color-brand);border-radius:4px;padding:1px 6px;font-size:0.7rem;margin-left:6px;font-weight:600;">'
                      + escHtml(f.city) + '</span>'
                    : '';
                item.innerHTML = '<div style="display:flex;align-items:center;flex-wrap:wrap;gap:2px;">'
                    + escHtml(f.name) + cityBadge + '</div>'
                    + '<div class="uni-suggestion-city">' + escHtml(f.address || '') + '</div>';
                item.addEventListener('mousedown', function (e) {
                    e.preventDefault();
                    selectFaculty(f);
                });
                uniDropdown.appendChild(item);
            });

            // Position under the input using fixed coords (avoids overflow:hidden clipping)
            var rect = uniSearch.getBoundingClientRect();
            uniDropdown.style.top    = rect.bottom + 'px';
            uniDropdown.style.left   = rect.left + 'px';
            uniDropdown.style.width  = rect.width + 'px';
            uniDropdown.style.display = 'block';
        }

        function highlightItem(items) {
            items.forEach(function (el) { el.classList.remove('active'); });
            if (activeIndex >= 0) items[activeIndex].classList.add('active');
        }

        function selectFaculty(f) {
            uniSearch.value = f.name;
            if (uniAddrInput) uniAddrInput.value = f.address || '';
            uniFeedback.textContent = '📍 ' + (f.address || f.name);
            uniFeedback.style.color = 'var(--color-brand)';
            closeDropdown();

            // Auto-pin the map
            if (!regMap) initRegMap();
            var hasCoords = f.latitude && f.longitude && !isNaN(f.latitude) && !isNaN(f.longitude);
            if (regMap && hasCoords) {
                regMap.setView([f.latitude, f.longitude], 16);
                if (regMarker) regMap.removeLayer(regMarker);
                regMarker = L.marker([f.latitude, f.longitude]).addTo(regMap)
                    .bindPopup('<strong>' + escHtml(f.name) + '</strong><br>' + escHtml(f.address || '')).openPopup();

                if (latInput)  latInput.value  = f.latitude;
                if (lngInput)  lngInput.value  = f.longitude;
                if (addrInput) addrInput.value = f.address || f.name;

                var display = document.getElementById('selectedLocationDisplay');
                display.textContent = '📍 ' + (f.address || f.name);
            }
        }

        function closeDropdown() {
            uniDropdown.style.display = 'none';
            uniDropdown.innerHTML = '';
            activeIndex = -1;
        }

        function escHtml(str) {
            var d = document.createElement('div');
            d.textContent = str;
            return d.innerHTML;
        }
    })();
    // ── End University autocomplete ────────────────────────────

    function initRegMap() {
        if (regMap) return;
        var mapEl = document.getElementById('map');
        if (!mapEl) return;
        // Don't check offsetParent — the container is visible after updateVisibility sets display:block

        regMap = L.map('map').setView([36.8065, 10.1815], 13);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
        }).addTo(regMap);

        // Force tile render after a short delay
        setTimeout(function() { regMap.invalidateSize(); }, 100);

        regMap.on('click', onMapClick);
    }

    function onMapClick(e) {
        var lat = e.latlng.lat;
        var lng = e.latlng.lng;

        if (regMarker) regMap.removeLayer(regMarker);
        regMarker = L.marker([lat, lng]).addTo(regMap);

        if (latInput) latInput.value = lat;
        if (lngInput) lngInput.value = lng;

        var display = document.getElementById('selectedLocationDisplay');
        display.textContent = '📍 Locating...';

        // Reverse geocode with Nominatim
        fetch('https://nominatim.openstreetmap.org/reverse?format=json&lat=' + lat + '&lon=' + lng)
            .then(function (res) { return res.json(); })
            .then(function (data) {
                if (addrInput) addrInput.value = data.display_name;
                display.textContent = '📍 ' + data.display_name;
            })
            .catch(function () {
                var coords = lat.toFixed(4) + ', ' + lng.toFixed(4);
                if (addrInput) addrInput.value = coords;
                display.textContent = '📍 ' + coords;
            });
    }
})();

/* ── Layer 1: Real-time email format validation ─────────────────── */
(function () {
    var emailInput   = document.getElementById('registration_email');
    var feedbackEl   = document.getElementById('emailFeedback');
    var iconEl       = document.getElementById('emailStatusIcon');
    if (!emailInput) return;

    // RFC-5322 simplified pattern — covers 99.9 % of real addresses
    var EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

    function setStatus(state, msg) {
        feedbackEl.textContent = msg;
        if (state === 'ok') {
            iconEl.textContent = '✅';
            iconEl.style.display = '';
            feedbackEl.style.color = 'var(--color-success, #38a169)';
            emailInput.style.borderColor = '#38a169';
        } else if (state === 'error') {
            iconEl.textContent = '❌';
            iconEl.style.display = '';
            feedbackEl.style.color = 'var(--color-error, #e53e3e)';
            emailInput.style.borderColor = '#e53e3e';
        } else {
            iconEl.style.display = 'none';
            feedbackEl.style.color = '';
            emailInput.style.borderColor = '';
        }
    }

    emailInput.addEventListener('input', function () {
        var val = this.value.trim();
        if (!val) { setStatus('idle', ''); return; }

        if (!EMAIL_RE.test(val)) {
            setStatus('error', 'Please enter a valid email address (e.g. you@example.com).');
            return;
        }

        // Looks like a valid format
        var domain = val.split('@')[1].toLowerCase();
        var freemail = ['gmail.com','yahoo.com','hotmail.com','outlook.com','live.com','icloud.com','protonmail.com'];
        if (freemail.indexOf(domain) !== -1) {
            setStatus('ok', 'Valid email address.');
        } else {
            setStatus('ok', '✓ Format OK — domain will be verified on submit.');
        }
    });

    emailInput.addEventListener('blur', function () {
        var val = this.value.trim();
        if (!val) { setStatus('idle', ''); return; }
        if (!EMAIL_RE.test(val)) {
            setStatus('error', 'Please enter a valid email address.');
        }
    });
})();
</script>
{% endblock %}
