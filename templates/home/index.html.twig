{% extends 'base.html.twig' %}
{% block voice_briefing %}
<script>window.__vcPage__ = { page: 'home', role: '{{ app.user ? (is_granted("ROLE_OWNER") ? "owner" : "student") : "guest" }}', briefing: { en: "Welcome to UNIDAR — student housing made simple. Browse listings, find roommates, or manage your properties.", fr: "Bienvenue sur UNIDAR — logements étudiants simplifiés. Parcourez les annonces, trouvez des colocataires.", ar: "مرحباً بك في يونيدار — سكن الطلاب بسهولة. تصفح الإعلانات أو ابحث عن شريك سكن." }, suggestions: [ {label:'Browse listings', cmd:'open listings'}, {label:'Find roommates', cmd:'find roommates'}, {label:'Login', cmd:'login'} ] };</script>
{% endblock %}
{% block title %}UNIDAR - Find Your Perfect Student Housing{% endblock %}

{% block stylesheets %}
<style>
    /* Animated hero gradient */
    .hero {
        background: linear-gradient(135deg,
            var(--color-primary-700) 0%,
            var(--color-primary-600) 25%,
            #7c3aed 50%,
            var(--color-primary-500) 75%,
            var(--color-primary-600) 100%);
        background-size: 400% 400%;
        animation: gradientShift 15s ease infinite;
        color: white;
        min-height: 90vh;
        display: flex;
        align-items: center;
        position: relative;
        overflow: hidden;
    }
    @keyframes gradientShift {
        0%   { background-position: 0% 50%; }
        50%  { background-position: 100% 50%; }
        100% { background-position: 0% 50%; }
    }
    .hero .floating-shapes { position:absolute; width:100%; height:100%; overflow:hidden; pointer-events:none; }
    .hero .shape { position:absolute; border-radius:50%; background:rgba(255,255,255,0.08); animation:float 20s ease-in-out infinite; }
    .hero .shape-1 { width:600px; height:600px; top:-200px; right:-150px; animation-delay:0s; }
    .hero .shape-2 { width:400px; height:400px; bottom:-100px; left:-100px; animation-delay:-5s; }
    .hero .shape-3 { width:200px; height:200px; top:50%; left:30%; animation-delay:-10s; }
    @keyframes float {
        0%,100% { transform:translate(0,0) rotate(0deg) scale(1); }
        25%  { transform:translate(30px,-30px) rotate(5deg) scale(1.05); }
        50%  { transform:translate(-20px,20px) rotate(-5deg) scale(0.95); }
        75%  { transform:translate(20px,30px) rotate(3deg) scale(1.02); }
    }
    .hero-content { position:relative; z-index:10; max-width:700px; }
    .hero-badge {
        display:inline-flex; align-items:center; gap:0.5rem;
        background:rgba(255,255,255,0.15); backdrop-filter:blur(10px);
        border:1px solid rgba(255,255,255,0.2);
        padding:0.5rem 1rem; border-radius:50px; font-size:0.875rem;
        margin-bottom:1.5rem; animation:slideInDown 0.8s ease-out;
    }
    .hero-badge-dot { width:8px; height:8px; background:#10b981; border-radius:50%; animation:pulse 2s ease-in-out infinite; }
    @keyframes pulse { 0%,100%{opacity:1;transform:scale(1);} 50%{opacity:0.5;transform:scale(1.2);} }
    .hero h1 {
        font-size:clamp(2.8rem,6vw,4.5rem); color:white;
        margin-bottom:1.5rem; line-height:1.1; letter-spacing:-0.03em;
        animation:slideInUp 0.8s ease-out 0.2s both;
    }
    .hero h1 span {
        background:linear-gradient(90deg,#fbbf24,#fb923c,#f472b6);
        -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text;
    }
    .hero p { font-size:1.125rem; max-width:550px; opacity:0.9; line-height:1.7; animation:slideInUp 0.8s ease-out 0.4s both; }
    .hero-actions { margin-top:2rem; display:flex; gap:1rem; flex-wrap:wrap; animation:slideInUp 0.8s ease-out 0.6s both; }
    .hero-actions .btn { padding:1rem 2rem; font-size:1rem; font-weight:700; border-radius:var(--radius-xl); }
    .hero-actions .btn-primary { background:white; color:var(--color-primary-700); box-shadow:0 10px 40px rgba(0,0,0,0.2); }
    .hero-actions .btn-primary:hover { background:var(--color-primary-100); transform:translateY(-3px); }
    .hero-actions .btn-secondary { border:2px solid rgba(255,255,255,0.5); color:white; background:transparent; }
    .hero-actions .btn-secondary:hover { background:rgba(255,255,255,0.1); border-color:white; transform:translateY(-3px); }
    .hero-stats { display:flex; gap:3rem; margin-top:4rem; animation:slideInUp 0.8s ease-out 0.8s both; flex-wrap:wrap; }
    .hero-stat { text-align:center; }
    .hero-stat-number { font-size:1.875rem; font-weight:700; display:block; }
    .hero-stat-label { font-size:0.875rem; opacity:0.8; }
    @keyframes slideInUp { from{opacity:0;transform:translateY(30px);} to{opacity:1;transform:translateY(0);} }
    @keyframes slideInDown { from{opacity:0;transform:translateY(-20px);} to{opacity:1;transform:translateY(0);} }

    /* Features */
    .features-section { background:var(--color-surface-50); padding:5rem 0; }
    .section-header { text-align:center; max-width:700px; margin:0 auto 4rem; }
    .section-tag { display:inline-block; background:var(--color-primary-100); color:var(--color-primary-700); padding:4px 16px; border-radius:50px; font-size:0.75rem; font-weight:700; text-transform:uppercase; letter-spacing:0.05em; margin-bottom:1rem; }
    .section-header h2 { font-size:clamp(2rem,4vw,2.8rem); letter-spacing:-0.02em; margin-bottom:1rem; }
    .section-header p { font-size:1.125rem; color:var(--color-text-muted); line-height:1.7; }
    .feature-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(300px,1fr)); gap:2rem; }
    .feature-card { background:white; border:1px solid var(--color-border); border-radius:var(--radius-xl); padding:2rem; transition:all 0.4s cubic-bezier(0.4,0,0.2,1); position:relative; overflow:hidden; }
    .feature-card::before { content:''; position:absolute; top:0; left:0; right:0; height:4px; background:linear-gradient(90deg,var(--color-primary-500),#7c3aed); opacity:0; transition:opacity 0.3s; }
    .feature-card:hover { transform:translateY(-8px); box-shadow:0 20px 40px rgba(0,0,0,0.1); }
    .feature-card:hover::before { opacity:1; }
    .feature-icon { width:64px; height:64px; border-radius:var(--radius-lg); display:flex; align-items:center; justify-content:center; font-size:28px; margin-bottom:1.5rem; }
    .feature-icon.blue { background:linear-gradient(135deg,#dbeafe,#bfdbfe); }
    .feature-icon.green { background:linear-gradient(135deg,#d1fae5,#a7f3d0); }
    .feature-icon.purple { background:linear-gradient(135deg,#ede9fe,#ddd6fe); }
    .feature-icon.orange { background:linear-gradient(135deg,#ffedd5,#fed7aa); }
    .feature-icon.pink { background:linear-gradient(135deg,#fce7f3,#fbcfe8); }
    .feature-icon.cyan { background:linear-gradient(135deg,#cffafe,#a5f3fc); }
    .feature-card h3 { font-size:1.25rem; margin-bottom:0.75rem; }
    .feature-card p { color:var(--color-text-muted); line-height:1.7; }

    /* For Students */
    .students-section { padding:5rem 0; background:white; }
    .split-content { display:grid; grid-template-columns:1fr 1fr; gap:4rem; align-items:center; }
    @media(max-width:900px){ .split-content{ grid-template-columns:1fr; } .visual-card-stack{ display:none; } }
    .split-text h2 { font-size:clamp(2rem,4vw,2.5rem); margin-bottom:1.5rem; letter-spacing:-0.02em; }
    .split-text p { font-size:1.125rem; color:var(--color-text-muted); line-height:1.8; margin-bottom:2rem; }
    .benefit-list { list-style:none; display:flex; flex-direction:column; gap:1rem; margin-bottom:2rem; }
    .benefit-list li { display:flex; align-items:flex-start; gap:1rem; font-size:1rem; }
    .benefit-icon { width:24px; height:24px; border-radius:50%; background:linear-gradient(135deg,#10b981,#34d399); display:flex; align-items:center; justify-content:center; color:white; font-size:13px; flex-shrink:0; margin-top:2px; }
    .visual-card-stack { position:relative; height:400px; }
    .visual-card { position:absolute; background:white; border-radius:var(--radius-xl); box-shadow:0 20px 60px rgba(0,0,0,0.15); padding:1.5rem; }
    .visual-card-1 { left:0; top:50px; width:280px; z-index:3; animation:cardFloat 6s ease-in-out infinite; }
    .visual-card-2 { right:0; top:0; width:240px; z-index:2; animation:cardFloat 6s ease-in-out infinite 1s; }
    .visual-card-3 { left:60px; bottom:0; width:260px; z-index:1; animation:cardFloat 6s ease-in-out infinite 2s; }
    @keyframes cardFloat { 0%,100%{transform:translateY(0);} 50%{transform:translateY(-10px);} }
    .visual-card-avatar { width:40px; height:40px; border-radius:50%; background:linear-gradient(135deg,var(--color-primary-400),var(--color-primary-600)); }
    .visual-card-bar { height:8px; border-radius:4px; background:var(--color-surface-100); margin-top:8px; }

    /* For Owners */
    .owners-section { padding:5rem 0; background:linear-gradient(135deg,var(--color-surface-900) 0%,#1e1b4b 100%); color:white; }
    .owners-section h2 { color:white; }
    .owners-section p { color:rgba(255,255,255,0.7); }
    .owners-section .benefit-list li { color:rgba(255,255,255,0.9); }
    .owners-section .btn-primary { background:linear-gradient(135deg,var(--color-primary-500),#7c3aed); box-shadow:0 10px 40px rgba(99,102,241,0.3); }
    .glow-card { background:rgba(255,255,255,0.05); backdrop-filter:blur(20px); border:1px solid rgba(255,255,255,0.1); border-radius:var(--radius-xl); padding:2rem; }
    .stats-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:1.5rem; }
    .stat-glow { text-align:center; background:rgba(255,255,255,0.05); border-radius:var(--radius-lg); padding:1.5rem; border:1px solid rgba(255,255,255,0.1); }
    .stat-glow-number { font-size:2rem; font-weight:800; color:white; display:block; margin-bottom:0.25rem; }
    .stat-glow-label { font-size:0.85rem; color:rgba(255,255,255,0.6); }

    /* How it works */
    .how-section { padding:5rem 0; background:var(--color-surface-50); }
    .steps-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:2rem; position:relative; }
    .step-card { text-align:center; padding:2rem 1.5rem; background:white; border-radius:var(--radius-xl); border:1px solid var(--color-border); transition:all 0.3s ease; }
    .step-card:hover { transform:translateY(-6px); box-shadow:0 20px 40px rgba(0,0,0,0.08); }
    .step-number { width:56px; height:56px; background:linear-gradient(135deg,var(--color-primary-500),#7c3aed); border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:1.25rem; font-weight:800; color:white; margin:0 auto 1.25rem; }
    .step-card h3 { font-size:1.1rem; margin-bottom:0.75rem; }
    .step-card p { color:var(--color-text-muted); font-size:0.9rem; line-height:1.6; }

    /* CTA */
    .cta-section { padding:5rem 0; background:linear-gradient(135deg,var(--color-primary-600),#7c3aed); color:white; text-align:center; }
    .cta-section h2 { font-size:clamp(2rem,4vw,2.8rem); color:white; margin-bottom:1rem; }
    .cta-section p { font-size:1.125rem; opacity:0.85; max-width:550px; margin:0 auto 2rem; }
    .cta-section .btn-primary { background:white; color:var(--color-primary-700); font-size:1.1rem; padding:1rem 2.5rem; border-radius:var(--radius-xl); }
</style>
{% endblock %}

{% block body %}
<!-- HERO -->
<section class="hero">
    <div class="floating-shapes">
        <div class="shape shape-1"></div>
        <div class="shape shape-2"></div>
        <div class="shape shape-3"></div>
    </div>
    <div class="container">
        <div class="hero-content">
            <div class="hero-badge">
                <span class="hero-badge-dot"></span>
                <span data-i18n="home_hero_badge">Trusted by Students Across Tunisia</span>
            </div>
            <h1 data-i18n="home_hero_title">Find Your <span>Perfect</span> Student Housing</h1>
            <p data-i18n="home_hero_subtitle">The premier platform for Tunisian university students. Discover verified listings, find compatible roommates, and secure safe housing near your campus—all in one place.</p>
            <div class="hero-actions">
                <a href="{{ path('listing_index') }}" class="btn btn-primary" data-i18n="home_hero_explore">Explore Listings</a>
                <a href="{{ path('roommate_index') }}" class="btn btn-secondary" data-i18n="home_hero_roommates">Find Roommates</a>
            </div>
            <div class="hero-stats">
                <div class="hero-stat">
                    <span class="hero-stat-number">500+</span>
                    <span class="hero-stat-label" data-i18n="home_hero_stat_listings">Verified Listings</span>
                </div>
                <div class="hero-stat">
                    <span class="hero-stat-number">2,000+</span>
                    <span class="hero-stat-label" data-i18n="home_hero_stat_students">Active Students</span>
                </div>
                <div class="hero-stat">
                    <span class="hero-stat-number">15+</span>
                    <span class="hero-stat-label" data-i18n="home_hero_stat_unis">Universities Covered</span>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- FEATURES -->
<section class="features-section">
    <div class="container">
        <div class="section-header">
            <span class="section-tag">Why UNIDAR?</span>
            <h2>Everything You Need to Find Your Home</h2>
            <p>We've built every feature students and owners need — from discovery to digital contracts.</p>
        </div>
        <div class="feature-grid">
            <div class="feature-card">
                <div class="feature-icon blue">🔍</div>
                <h3>Smart Search</h3>
                <p>Filter listings by price, number of bedrooms, property type, gender preference, and distance from your university using our Haversine-powered map search.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon green">📄</div>
                <h3>Digital Contracts</h3>
                <p>Sign rental contracts digitally. Tunisia-compliant legal templates, digital signatures, and automatic contract management — no paperwork needed.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon purple">🤝</div>
                <h3>Roommate Matching</h3>
                <p>Our compatibility algorithm scores potential roommates on 7 criteria: budget, cleanliness, smoking, noise, sleep schedule, gender preference, and guests.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon orange">✅</div>
                <h3>Verified Listings</h3>
                <p>All owners go through identity verification. Students submit their student ID for a verified badge, ensuring a trusted community.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon pink">💬</div>
                <h3>Real-Time Messaging</h3>
                <p>Contact owners directly through our built-in messaging system. Conversations are organized by listing for easy tracking.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon cyan">💳</div>
                <h3>Secure Payments</h3>
                <p>Pay rent and security deposits through the platform. Transparent 5% commission — owners receive 95% directly.</p>
            </div>
        </div>
    </div>
</section>

<!-- FOR STUDENTS -->
<section class="students-section">
    <div class="container">
        <div class="split-content">
            <div class="split-text">
                <span class="section-tag">For Students</span>
                <h2>Find Housing That Fits Your Life</h2>
                <p>From your first search to moving in, UNIDAR handles everything so you can focus on your studies.</p>
                <ul class="benefit-list">
                    <li>
                        <div class="benefit-icon">✓</div>
                        <div><strong>Location-based search</strong> — find listings near your faculty with distance filters</div>
                    </li>
                    <li>
                        <div class="benefit-icon">✓</div>
                        <div><strong>Digital contract signing</strong> — sign securely from your phone or laptop</div>
                    </li>
                    <li>
                        <div class="benefit-icon">✓</div>
                        <div><strong>Roommate compatibility</strong> — get matched with students who share your lifestyle</div>
                    </li>
                    <li>
                        <div class="benefit-icon">✓</div>
                        <div><strong>Dashboard tracking</strong> — manage your contracts, payments, and messages in one place</div>
                    </li>
                </ul>
                {% if not is_granted('ROLE_USER') %}
                <a href="{{ path('app_register') }}" class="btn btn-primary">Get Started Free</a>
                {% else %}
                <a href="{{ path('listing_index') }}" class="btn btn-primary">Browse Listings</a>
                {% endif %}
            </div>
            <div class="split-visual">
                <div class="visual-card-stack">
                    <div class="visual-card visual-card-1">
                        <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:1rem;">
                            <div class="visual-card-avatar"></div>
                            <div>
                                <div style="font-weight:600;font-size:0.875rem;">Studio near ENIT</div>
                                <div style="font-size:0.75rem;color:var(--color-text-muted);">El Belvedère, Tunis</div>
                            </div>
                        </div>
                        <div style="font-size:1.25rem;font-weight:700;color:var(--color-brand);">450 TND/mo</div>
                        <div class="visual-card-bar" style="width:100%;margin-top:12px;"></div>
                        <div class="visual-card-bar" style="width:80%;"></div>
                    </div>
                    <div class="visual-card visual-card-2">
                        <div style="text-align:center;padding:0.5rem 0;">
                            <div style="font-size:2rem;font-weight:800;color:var(--color-brand);">92%</div>
                            <div style="font-size:0.75rem;color:var(--color-text-muted);">Roommate Match</div>
                        </div>
                        <div class="visual-card-bar" style="width:92%;background:linear-gradient(90deg,var(--color-primary-400),#7c3aed);height:6px;border-radius:3px;margin-top:8px;"></div>
                    </div>
                    <div class="visual-card visual-card-3">
                        <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.75rem;">
                            <span style="font-size:1.25rem;">✅</span>
                            <div>
                                <div style="font-weight:600;font-size:0.875rem;">Contract Signed</div>
                                <div style="font-size:0.75rem;color:var(--color-text-muted);">Both parties confirmed</div>
                            </div>
                        </div>
                        <div class="visual-card-bar" style="width:100%;"></div>
                        <div class="visual-card-bar" style="width:60%;"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- FOR OWNERS -->
<section class="owners-section">
    <div class="container">
        <div class="split-content">
            <div class="split-text">
                <span class="section-tag" style="background:rgba(255,255,255,0.1);color:rgba(255,255,255,0.9);">For Owners</span>
                <h2>Rent Smarter, Not Harder</h2>
                <p>List your property, screen students, and manage everything digitally — without the stress of traditional rentals.</p>
                <ul class="benefit-list">
                    <li>
                        <div class="benefit-icon">✓</div>
                        <div><strong>Easy listing creation</strong> — add photos, location, amenities in minutes</div>
                    </li>
                    <li>
                        <div class="benefit-icon">✓</div>
                        <div><strong>Verified tenants only</strong> — all students are identity-verified through the platform</div>
                    </li>
                    <li>
                        <div class="benefit-icon">✓</div>
                        <div><strong>Digital contract management</strong> — generate, send, and track signed contracts online</div>
                    </li>
                    <li>
                        <div class="benefit-icon">✓</div>
                        <div><strong>Transparent payments</strong> — receive 95% of rent directly, 5% platform fee only</div>
                    </li>
                </ul>
                {% if not is_granted('ROLE_USER') %}
                <a href="{{ path('app_register') }}" class="btn btn-primary">List Your Property</a>
                {% else %}
                <a href="{{ path('listing_new') }}" class="btn btn-primary">Add Listing</a>
                {% endif %}
            </div>
            <div class="glow-card">
                <div class="stats-grid">
                    <div class="stat-glow">
                        <span class="stat-glow-number">500+</span>
                        <span class="stat-glow-label">Active Listings</span>
                    </div>
                    <div class="stat-glow">
                        <span class="stat-glow-number">2,000+</span>
                        <span class="stat-glow-label">Happy Students</span>
                    </div>
                    <div class="stat-glow">
                        <span class="stat-glow-number">95%</span>
                        <span class="stat-glow-label">Owner Payout Rate</span>
                    </div>
                    <div class="stat-glow">
                        <span class="stat-glow-number">53</span>
                        <span class="stat-glow-label">Universities Covered</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- HOW IT WORKS -->
<section class="how-section">
    <div class="container">
        <div class="section-header">
            <span class="section-tag">Simple Process</span>
            <h2>Start in Minutes</h2>
            <p>Getting housed or renting out has never been this straightforward.</p>
        </div>
        <div class="steps-grid">
            <div class="step-card">
                <div class="step-number">1</div>
                <h3>Create Account</h3>
                <p>Sign up as a student or property owner in under 2 minutes.</p>
            </div>
            <div class="step-card">
                <div class="step-number">2</div>
                <h3>Browse or List</h3>
                <p>Students browse verified listings. Owners post properties with photos and maps.</p>
            </div>
            <div class="step-card">
                <div class="step-number">3</div>
                <h3>Connect</h3>
                <p>Message directly through the platform. Schedule visits and ask questions.</p>
            </div>
            <div class="step-card">
                <div class="step-number">4</div>
                <h3>Sign & Move In</h3>
                <p>Generate a Tunisia-compliant contract, sign digitally, pay the deposit — done.</p>
            </div>
        </div>
    </div>
</section>

<!-- CTA -->
{% if not is_granted('ROLE_USER') %}
<section class="cta-section">
    <div class="container">
        <h2>Ready to Find Your Home?</h2>
        <p>Join thousands of Tunisian students who found their perfect housing through UNIDAR.</p>
        <a href="{{ path('app_register') }}" class="btn btn-primary">Get Started — It's Free</a>
    </div>
</section>
{% endif %}
{% endblock %}
