{% extends 'base.html.twig' %}
{% block voice_briefing %}
<script>window.__vcPage__ = { page: 'messages', role: '{{ app.user ? (is_granted("ROLE_OWNER") ? "owner" : "student") : "guest" }}', briefing: { en: "Messages. Your conversations with landlords and students.", fr: "Messagerie. Vos conversations.", ar: "الرسائل. محادثاتك." }, suggestions: [ {label:'Go to listings', cmd:'open listings'}, {label:'Go to dashboard', cmd:'go to dashboard'} ] };</script>
{% endblock %}
{% block title %}Messages - UNIDAR{% endblock %}

{% block body %}
<main class="section" style="padding: 2rem 0;">
    <div class="container">
        <div class="card premium-card text-center fade-in-up" style="padding: 4rem;">
            <div style="font-size: 4rem; margin-bottom: 1rem;">💬</div>
            <h3 style="margin-bottom: 0.5rem;">Use the Chat Widget</h3>
            <p class="text-muted" style="max-width: 400px; margin: 0 auto 1.5rem;">Click the chat bubble in the bottom-right corner to view your conversations.</p>
            <button type="button" class="btn btn-primary" onclick="if(window.chatWidget){chatWidget.toggle(true)}">Open Chat</button>
        </div>
    </div>
</main>
{% endblock %}

{% block javascripts %}
<script>
    // Auto-open chat widget when visiting this page
    document.addEventListener('DOMContentLoaded', function() {
        setTimeout(function() {
            if (window.chatWidget) chatWidget.toggle(true);
        }, 500);
    });
</script>
{% endblock %}
