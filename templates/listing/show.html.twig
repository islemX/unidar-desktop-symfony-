                if (water) html += '<div style="padding:0.5rem;background:#f8fafc;border-radius:6px;font-size:0.8rem;"><div style="color:#64748b;">💧 Water</div><div style="font-weight:700;">'      + water + ' TND/mo</div></div>';
                var annual = d.total_annual || monthly * 12;
                if (annual) html += '<div style="padding:0.5rem;background:#f0f9ff;border-radius:6px;font-size:0.8rem;grid-column:1/-1;"><div style="color:#0369a1;">📅 Annual estimate</div><div style="font-weight:700;">' + annual + ' TND/year</div></div>';
