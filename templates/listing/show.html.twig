            html += '<div><div style="font-weight:800;font-size:1.15rem;color:#1e293b;">~' + monthly + ' TND</div>';
            html += '<div style="font-size:0.78rem;color:#64748b;">estimated monthly utilities</div></div></div>';
            // Breakdown grid — flat fields from API
            var elec  = d.electricity_monthly || (d.breakdown && d.breakdown.electricity_tnd) || 0;
            var water = d.water_monthly       || (d.breakdown && d.breakdown.water_tnd)       || 0;
