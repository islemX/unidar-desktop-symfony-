                html += '<div style="font-size:0.82rem;font-weight:700;color:#374151;margin-bottom:0.4rem;">💡 Saving tips:</div>';
                tips.slice(0,3).forEach(function(t) { html += '<div class="ai-tip"><span>•</span><span>' + t + '</span></div>'; });
            }
            if (d.disclaimer) {
                html += '<div style="font-size:0.72rem;color:#94a3b8;margin-top:0.6rem;">ℹ ' + d.disclaimer + '</div>';
            }
            box.innerHTML = html;
        })
        .catch(function() { box.innerHTML = '<p style="color:#ef4444;font-size:0.84rem;">Could not estimate energy costs.</p>'; });
}

