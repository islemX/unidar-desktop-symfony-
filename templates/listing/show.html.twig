{% extends 'base.html.twig' %}
{% block voice_briefing %}
<script>window.__vcPage__ = { page: 'listing_show', role: '{{ app.user ? (is_granted("ROLE_OWNER") ? "owner" : "student") : "guest" }}', briefing: { en: "Property: {{ listing.title|e('js') }}. {{ listing.price }} TND per month. {{ listing.bedrooms }} bedroom{{ listing.bedrooms != 1 ? 's' : '' }}. Say 'generate contract', 'send message', or 'save listing'.", fr: "Logement: {{ listing.title|e('js') }}. {{ listing.price }} TND par mois. Dites 'générer contrat' ou 'envoyer message'.", ar: "العقار: {{ listing.title|e('js') }}. {{ listing.price }} دينار شهرياً. قل 'إنشاء عقد' أو 'إرسال رسالة'." }, suggestions: [ {label:'Generate contract', cmd:'generate contract'}, {label:'Send message', cmd:'send message'}, {label:'Save listing', cmd:'save listing'}, {label:'Go back', cmd:'go back'} ] };</script>
{% endblock %}
{% block title %}{{ listing.title }} - UNIDAR{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="https://unpkg.com/leaflet-routing-machine@3.2.12/dist/leaflet-routing-machine.css" />
<style>
    /* ── Route steps panel (rendered below the map) ── */
    .route-steps-panel {
        display: none;
        margin-top: 0.75rem;
        border: 1px solid var(--color-surface-100);
        border-radius: var(--radius-lg);
        overflow: hidden;
    }
    .route-steps-panel.active { display: block; }
    .route-steps-header {
        display: flex; justify-content: space-between; align-items: center;
        padding: 0.65rem 1rem;
        background: linear-gradient(135deg, rgba(99,102,241,0.08), rgba(79,70,229,0.08));
        border-bottom: 1px solid var(--color-surface-100);
        font-size: 0.82rem; font-weight: 700; color: var(--color-brand);
    }
    .route-steps-header button {
        background: none; border: none; cursor: pointer;
        font-size: 0.78rem; color: var(--color-text-muted); font-weight: 600;
    }
    .route-steps-list {
        max-height: 220px; overflow-y: auto;
        padding: 0; margin: 0; list-style: none;
    }
    .route-steps-list li {
        display: flex; justify-content: space-between; align-items: baseline;
        padding: 0.5rem 1rem; font-size: 0.83rem; border-bottom: 1px solid #f1f5f9;
        gap: 0.5rem;
    }
    .route-steps-list li:last-child { border-bottom: none; }
    .route-steps-list .step-text { color: #374151; flex: 1; }
    .route-steps-list .step-dist { color: var(--color-brand); font-weight: 700; white-space: nowrap; font-size: 0.78rem; }
    /* Hide the default LRM map control — we render instructions ourselves */
    .leaflet-routing-container { display: none !important; }

    .listing-layout { display: grid; grid-template-columns: 1fr 400px; gap: 2rem; align-items: start; }
    @media(max-width: 960px) { .listing-layout { grid-template-columns: 1fr; } }

    /* Gallery */
    .gallery-pro { border-radius: var(--radius-2xl); overflow: hidden; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.15); aspect-ratio: 16/10; position: relative; cursor: pointer; }
    .gallery-pro img.main-image { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s ease; }
    .gallery-pro:hover img.main-image { transform: scale(1.05); }
    .gallery-counter { position: absolute; bottom: 12px; left: 12px; background: rgba(0,0,0,0.6); color: white; padding: 4px 12px; border-radius: 50px; font-size: 0.8rem; font-weight: 500; backdrop-filter: blur(8px); }
    .thumbnails-strip { display: flex; gap: 0.5rem; margin-top: 0.75rem; overflow-x: auto; padding-bottom: 0.5rem; }
    .thumb-pro { width: 72px; height: 54px; border-radius: var(--radius-md); object-fit: cover; cursor: pointer; opacity: 0.6; transition: all 0.3s; border: 2px solid transparent; flex-shrink: 0; }
    .thumb-pro:hover, .thumb-pro.active { opacity: 1; border-color: var(--color-brand); transform: translateY(-3px); }

    /* Lightbox */
    .lightbox-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.92); backdrop-filter: blur(20px); z-index: 50000; display: none; align-items: center; justify-content: center; flex-direction: column; }
    .lightbox-overlay.active { display: flex; }
    .lightbox-overlay img { max-width: 90vw; max-height: 80vh; object-fit: contain; border-radius: var(--radius-lg); }
    .lightbox-close { position: absolute; top: 20px; right: 30px; background: none; border: none; color: white; font-size: 2rem; cursor: pointer; z-index: 50001; }
    .lightbox-nav { position: absolute; top: 50%; transform: translateY(-50%); background: rgba(255,255,255,0.15); border: none; color: white; font-size: 2rem; cursor: pointer; padding: 12px 18px; border-radius: var(--radius-lg); backdrop-filter: blur(8px); }
    .lightbox-nav:hover { background: rgba(255,255,255,0.3); }
    .lightbox-prev { left: 20px; }
    .lightbox-next { right: 20px; }
    .lightbox-counter { color: rgba(255,255,255,0.7); margin-top: 16px; font-size: 0.9rem; }

    /* Detail stats */
    .detail-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin-top: 1.5rem; }
    .detail-stat { text-align: center; padding: 1rem; background: var(--color-surface-50); border-radius: var(--radius-lg); border: 1px solid var(--color-border); }
    .detail-stat-icon { font-size: 1.5rem; margin-bottom: 0.25rem; }
    .detail-stat-value { font-weight: 700; font-size: 1.1rem; }
    .detail-stat-label { font-size: 0.78rem; color: var(--color-text-muted); }

    /* Sidebar */
    .sidebar-card { background: white; border: 1px solid var(--color-border); border-radius: var(--radius-xl); padding: 1.5rem; box-shadow: var(--shadow-sm); position: sticky; top: 90px; }
    .price-big { font-size: 2rem; font-weight: 800; color: var(--color-brand); }
    .price-big span { font-size: 1rem; font-weight: 400; color: var(--color-text-muted); }
    .amenity-tag { display: inline-flex; align-items: center; gap: 6px; padding: 6px 14px; background: var(--color-surface-50); border: 1px solid var(--color-border); border-radius: 50px; font-size: 0.82rem; font-weight: 500; }

    /* Map + Trajectory */
    #listingMap { height: 500px; border-radius: var(--radius-xl); overflow: hidden; border: 1px solid var(--color-surface-100); box-shadow: 0 10px 25px -5px rgba(0,0,0,0.1); }
    .faculty-selector-container { background: var(--color-surface-50); padding: 1.25rem; border-radius: var(--radius-xl); border: 1px solid var(--color-surface-100); margin-bottom: 1rem; }
    .map-controls-premium { display: inline-flex; background: white; border: 1px solid var(--color-border); border-radius: 50px; padding: 4px; gap: 2px; }
    .map-mode-btn { border: none; background: transparent; padding: 8px 16px; border-radius: 50px; cursor: pointer; font-size: 0.85rem; font-weight: 600; color: var(--color-text-muted); transition: all 0.2s; }
    .map-mode-btn.active { background: linear-gradient(135deg, var(--color-brand), #4f46e5); color: white; box-shadow: 0 4px 10px -2px rgba(99,102,241,0.4); }
    .compass-btn { display: inline-flex; align-items: center; gap: 8px; padding: 8px 16px; background: white; border: 1px solid var(--color-border); border-radius: 50px; cursor: pointer; font-weight: 600; font-size: 0.85rem; transition: all 0.2s; }
    .compass-btn:hover { border-color: var(--color-brand); color: var(--color-brand); }
    .route-info { background: linear-gradient(135deg, rgba(99,102,241,0.08), rgba(79,70,229,0.08)); border: 1px solid rgba(99,102,241,0.2); border-radius: var(--radius-lg); padding: 0.75rem 1rem; margin-top: 0.75rem; font-size: 0.9rem; display: none; }
    .route-info.active { display: flex; justify-content: space-around; gap: 1rem; flex-wrap: wrap; }
    .route-info b { color: var(--color-brand); font-size: 1.05rem; }

    /* AI widgets */
    .ai-score-ring { display: inline-flex; align-items: center; justify-content: center; width: 64px; height: 64px; border-radius: 50%; font-size: 1.2rem; font-weight: 800; color: white; flex-shrink: 0; }
    .ai-issue { display: flex; align-items: flex-start; gap: 0.5rem; padding: 0.5rem 0; border-bottom: 1px solid var(--color-surface-50); font-size: 0.85rem; }
    .ai-issue:last-child { border-bottom: none; }
    .ai-suggestion { background: linear-gradient(100deg,#eef2ff,#f5f3ff); border: 1px solid #c7d2fe; border-radius: var(--radius-lg); padding: 0.65rem 0.9rem; font-size: 0.83rem; margin-top: 0.4rem; }

    /* Modal overlay */
    .modal-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(17,24,39,0.55); backdrop-filter: blur(6px); z-index: 10000; display: none; align-items: center; justify-content: center; padding: 1rem; }
    .modal-overlay.active { display: flex; }
    .modal { background: white; border-radius: var(--radius-xl); padding: 0; max-width: 500px; width: 100%; max-height: 92vh; overflow: hidden; box-shadow: 0 40px 80px -20px rgba(0,0,0,0.4); display: flex; flex-direction: column; }
    .modal-header { padding: 1.5rem 2rem 1rem; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--color-surface-100); }
    .modal-header h3 { margin: 0; font-size: 1.25rem; font-weight: 700; }
    .modal-body { padding: 1.5rem 2rem 2rem; overflow-y: auto; }
    .modal-close { background: var(--color-surface-50); border: 1px solid var(--color-border); font-size: 1.1rem; cursor: pointer; color: var(--color-text-muted); width: 36px; height: 36px; border-radius: 50%; display: flex; align-items: center; justify-content: center; }

    @media(max-width: 600px) {
        .detail-stats { grid-template-columns: repeat(2, 1fr); }
    }

    /* ── Voice Navigation ─────────────────────────────────────────────────── */
    @keyframes vnavMicPulse {
        0%, 100% { opacity: 1; } 50% { opacity: 0.55; }
    }
    .vnav-panel {
        margin-top: 0.75rem;
        border: 1.5px solid rgba(99,102,241,0.22);
        border-radius: var(--radius-xl);
        overflow: hidden;
        background: #fff;
        box-shadow: 0 8px 28px -6px rgba(99,102,241,0.14);
    }
    .vnav-header {
        display: flex; justify-content: space-between; align-items: center;
        padding: 0.7rem 1rem;
        background: linear-gradient(135deg, rgba(99,102,241,0.08), rgba(79,70,229,0.05));
        border-bottom: 1px solid rgba(99,102,241,0.1);
    }
    .vnav-title { font-size: 0.875rem; font-weight: 700; color: var(--color-brand); }
    .vnav-langs { display: flex; gap: 4px; }
    .vnav-lang {
        border: 1px solid var(--color-border); background: white;
        border-radius: 50px; padding: 3px 10px;
        font-size: 0.73rem; font-weight: 600; cursor: pointer;
        color: var(--color-text-muted); transition: all 0.2s;
    }
    .vnav-lang.active, .vnav-lang:hover {
        background: var(--color-brand); color: white; border-color: var(--color-brand);
    }
    .vnav-bar  { height: 4px; background: #e0e7ff; }
    .vnav-fill { height: 100%; background: linear-gradient(90deg,#6366f1,#4f46e5); width: 0%; transition: width 0.6s ease; }
    .vnav-step { padding: 1rem 1.25rem 0.75rem; border-bottom: 1px solid var(--color-surface-100); }
    .vnav-step-meta { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.4rem; }
    .vnav-step-badge {
        display: inline-block; background: rgba(99,102,241,0.1);
        color: var(--color-brand); font-size: 0.72rem; font-weight: 700;
        padding: 2px 9px; border-radius: 50px;
    }
    .vnav-step-dist { font-size: 0.78rem; color: var(--color-text-muted); font-weight: 600; }
    .vnav-step-text { font-size: 1rem; font-weight: 600; color: #1e293b; line-height: 1.4; }
    .vnav-info {
        display: flex; gap: 1.25rem; align-items: center; padding: 0.6rem 1.25rem;
        font-size: 0.82rem; color: var(--color-text-muted);
        border-bottom: 1px solid var(--color-surface-100); flex-wrap: wrap;
    }
    .vnav-info b { color: var(--color-brand); }
    .vnav-gps-tag { font-size: 0.75rem; }
    .vnav-btns { display: flex; gap: 0.5rem; padding: 0.75rem 1rem; flex-wrap: wrap; }
    .vnav-btn {
        flex: 1; min-width: 68px; padding: 8px 12px;
        border: none; border-radius: var(--radius-md);
        font-size: 0.82rem; font-weight: 700; cursor: pointer; transition: all 0.2s;
    }
    .vnav-pri { background: var(--color-brand); color: white; }
    .vnav-pri:hover { background: #4f46e5; }
    .vnav-sec { background: var(--color-surface-50); color: #374151; border: 1px solid var(--color-border); }
    .vnav-sec:hover { background: #e0e7ff; color: var(--color-brand); border-color: var(--color-brand); }
    .vnav-dan { background: #fef2f2; color: #dc2626; border: 1px solid #fecaca; }
    .vnav-dan:hover { background: #dc2626; color: white; }
    .vnav-mic {
        margin: 0 1rem 0.75rem; padding: 7px 14px;
        background: linear-gradient(90deg, #fef3c7, #fffbeb);
        border: 1px solid #fde68a; border-radius: var(--radius-md);
        font-size: 0.79rem; color: #92400e;
        align-items: center; gap: 6px;
        animation: vnavMicPulse 2s ease-in-out infinite;
    }
    /* Voice Nav launch button (in directions panel header) */
    #startVoiceNavBtn:hover { opacity: 0.88; transform: translateY(-1px); transition: all 0.2s; }
</style>
{% endblock %}

{% block body %}
<div class="floating-shapes"><div class="shape shape-1"></div><div class="shape shape-2"></div></div>

<main style="padding: 2rem 0 4rem;">
    <div class="container">
        <div style="margin-bottom: 1.25rem;">
            <a href="{{ path('listing_index') }}" style="color: var(--color-brand); font-weight: 500; font-size: 0.9rem;">← Back to listings</a>
        </div>

        <div class="listing-layout">
            <!-- Left Column -->
            <div>
                <!-- Gallery -->
                <div class="gallery-pro" onclick="openLightbox(currentImageIndex)">
                    {% if listing.images is not empty %}
                        {% set firstImg = listing.images.first.imagePath %}
                        <img id="mainImage" class="main-image" src="{{ firstImg starts with 'http' ? firstImg : '/uploads/listings/' ~ firstImg }}" alt="{{ listing.title }}">
                        <div class="gallery-counter" id="galleryCounter">1 / {{ listing.images|length }} Photos</div>
                    {% else %}
                        <div style="width: 100%; height: 100%; background: linear-gradient(135deg, var(--color-primary-600), #7c3aed); display: flex; align-items: center; justify-content: center; color: white; font-size: 5rem;">🏠</div>
                    {% endif %}
                </div>
                {% if listing.images|length > 1 %}
                    <div class="thumbnails-strip">
                        {% for img in listing.images %}
                            {% set imgSrc = img.imagePath starts with 'http' ? img.imagePath : '/uploads/listings/' ~ img.imagePath %}
                            <img class="thumb-pro {{ loop.first ? 'active' }}" src="{{ imgSrc }}" alt=""
                                 data-index="{{ loop.index0 }}"
                                 onclick="selectImage({{ loop.index0 }})">
                        {% endfor %}
                    </div>
                {% endif %}

                <!-- Details Card -->
                <div class="card" style="margin-top: 1.5rem;">
                    <h1 style="font-size: 1.5rem; margin-bottom: 0.5rem;">{{ listing.title }}</h1>
                    <p style="color: var(--color-text-muted); margin-bottom: 1rem; display: flex; align-items: center; gap: 4px;">📍 {{ listing.address }}</p>
                    <p style="line-height: 1.7;">{{ listing.description }}</p>

                    <div class="detail-stats">
                        <div class="detail-stat">
                            <div class="detail-stat-icon">🛏</div>
                            <div class="detail-stat-value">{{ listing.bedrooms }}</div>
                            <div class="detail-stat-label">Bedrooms</div>
                        </div>
                        <div class="detail-stat">
                            <div class="detail-stat-icon">🚿</div>
                            <div class="detail-stat-value">{{ listing.bathrooms }}</div>
                            <div class="detail-stat-label">Bathrooms</div>
                        </div>
                        <div class="detail-stat">
                            <div class="detail-stat-icon">👥</div>
                            <div class="detail-stat-value">{{ listing.capacity }}</div>
                            <div class="detail-stat-label">Capacity</div>
                        </div>
                        <div class="detail-stat">
                            <div class="detail-stat-icon">🛏</div>
                            <div class="detail-stat-value">{{ listing.bedsCount }}</div>
                            <div class="detail-stat-label">Beds</div>
                        </div>
                    </div>
                </div>

                {% if listing.amenities is defined and listing.amenities %}
                <div class="card" style="margin-top: 1rem;">
                    <h3 style="margin-bottom: 1rem;">Amenities</h3>
                    <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
                        {% for amenity in listing.amenities %}
                            <span class="amenity-tag">{{ amenity }}</span>
                        {% endfor %}
                    </div>
                </div>
                {% endif %}

                {% if is_granted('ROLE_OWNER') and app.user == listing.owner %}
                <!-- AI Listing Quality Score -->
                <div class="card" style="margin-top: 1rem;" id="aiQualitySection">
                    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.75rem;">
                        <h3 style="margin:0;font-size:1.05rem;">🤖 AI Listing Score</h3>
                        <button type="button" id="aiAnalyzeBtn" onclick="loadAiScore()" class="btn btn-secondary btn-sm">Analyze Listing</button>
                    </div>
                    <div id="aiQualityContent">
                        <p style="font-size:0.85rem;color:var(--color-text-muted);">Get AI-powered recommendations to improve your listing and attract more students.</p>
                    </div>
                </div>
                {% endif %}

                <!-- Map & Trajectory -->
                {% if listing.latitude and listing.longitude %}
                <div class="card" style="margin-top: 1rem;" id="mapSection">
                    <h3 style="margin-bottom: 0.25rem;">📍 Location &amp; Directions</h3>
                    <p class="text-muted" style="margin-bottom: 1rem; font-size: 0.9rem;">Calculate your route from any university in Tunisia</p>

                    <div class="faculty-selector-container">
                        <div style="display: grid; grid-template-columns: 1fr auto; gap: 0.75rem; align-items: end; margin-bottom: 0.75rem;">
                            <div>
                                <label class="form-label" style="font-weight: 600;">🎓 Choose your faculty</label>
                                <select id="facultySelector" class="form-input" style="width:100%; padding: 10px 12px; border: 1px solid var(--color-border); border-radius: var(--radius-md); cursor: pointer;">
                                    <option value="">-- Select a university --</option>
                                </select>
                            </div>
                            <button type="button" id="getDirectionsBtn" class="btn btn-primary" style="height: 42px;" disabled>
                                <span id="transportEmoji">🚗</span> Get route
                            </button>
                        </div>
                        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;">
                            <div class="map-controls-premium">
                                <button type="button" class="map-mode-btn active" id="modeDriving" onclick="setTravelMode('driving')">🚗 Driving</button>
                                <button type="button" class="map-mode-btn" id="modeWalking" onclick="setTravelMode('walking')">🚶 Walking</button>
                            </div>
                            <div id="routeInfo" class="route-info">
                                <span>📏 <b id="routeDistance">—</b></span>
                                <span>⏱ <b id="routeDuration">—</b></span>
                            </div>
                        </div>
                    </div>

                    <div id="listingMap"></div>
                    <div class="route-steps-panel" id="routeStepsPanel">
                        <div class="route-steps-header">
                            <span>🗺️ Turn-by-turn directions</span>
                            <div style="display:flex;gap:0.5rem;align-items:center;">
                                <button type="button" id="startVoiceNavBtn"
                                    style="display:none;background:linear-gradient(135deg,#6366f1,#4f46e5);color:#fff;border:none;border-radius:50px;padding:5px 14px;font-size:0.78rem;font-weight:700;cursor:pointer;white-space:nowrap;"
                                    onclick="if(window.VoiceNav){VoiceNav.start();}else{alert('Voice navigation is loading, please try again.');}">
                                    🎙️ Voice Nav
                                </button>
                                <button type="button" onclick="document.getElementById('routeStepsPanel').classList.remove('active')">✕ Close</button>
                            </div>
                        </div>
                        <ol class="route-steps-list" id="routeStepsList"></ol>
                    </div>
                </div>
                {% endif %}
            </div>

            <!-- Right Column / Sidebar -->
            <div class="sidebar-card">
                <div class="price-big" style="margin-bottom: 0.75rem;">
                    {{ listing.price }} TND<span>/month</span>
                </div>

                <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 1.25rem;">
                    <span class="badge badge-primary">{{ listing.propertyType.value|replace({'_': ' '})|title }}</span>
                    {% if listing.genderPreference %}
                        <span class="badge badge-warning">{{ listing.genderPreference|capitalize }} only</span>
                    {% endif %}
                </div>

                {% if listing.availableFrom %}
                    <p style="color: var(--color-text-muted); font-size: 0.9rem; margin-bottom: 0.5rem;">
                        📅 Available from: <strong>{{ listing.availableFrom|date('d/m/Y') }}</strong>
                    </p>
                {% endif %}

                <div style="display: flex; align-items: center; gap: 0.75rem; padding: 1rem; background: var(--color-surface-50); border-radius: var(--radius-lg); margin-bottom: 1.25rem;">
                    <div class="avatar">{{ listing.owner.fullName|slice(0,1)|upper }}</div>
                    <div>
                        <div style="font-weight: 600;">{{ listing.owner.fullName }}</div>
                        <div style="font-size: 0.8rem; color: var(--color-text-muted);">Property Owner</div>
                    </div>
                </div>

                {% if is_granted('ROLE_USER') and app.user != listing.owner %}
                    {% set has_tenant = first_tenant is defined and first_tenant is not null %}
                    {% set needs_sub = is_granted('ROLE_STUDENT') and not is_granted('ROLE_OWNER') and not is_granted('ROLE_ADMIN') and (has_subscription is defined and not has_subscription) %}

                    {% if needs_sub and not (has_tenant and not viewer_is_tenant) and not viewer_is_tenant %}
                        <div style="position:relative;overflow:hidden;padding:0.85rem 1rem;margin-bottom:0.75rem;border-radius:var(--radius-lg);background:linear-gradient(100deg,#fffaf0,#fff);border:1px solid #fde68a;">
                            <div style="display:flex;align-items:flex-start;gap:0.75rem;">
                                <div style="flex:0 0 34px;width:34px;height:34px;border-radius:10px;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,#f59e0b,#ef4444);color:#fff;font-size:1rem;box-shadow:0 6px 16px -4px rgba(245,158,11,0.55);">⭐</div>
                                <div style="font-size:0.84rem;color:#78350f;line-height:1.45;">
                                    <strong>Subscription required.</strong> You need an active UNIDAR plan to message the owner or generate a contract.
                                    <a href="{{ path('subscription_index') }}" style="display:inline-block;margin-top:0.35rem;font-weight:700;color:#b45309;text-decoration:underline;">Subscribe now →</a>
                                </div>
                            </div>
                        </div>
                    {% endif %}

                    {% if has_tenant and not viewer_is_tenant %}
                        {# An existing tenant already holds an active/paid contract.
                           Prospective students must contact the tenant, NOT the owner,
                           and cannot generate a new contract from this page. #}
                        <div style="padding: 0.75rem 1rem; background: #fff7ed; border: 1px solid #fed7aa; border-radius: var(--radius-lg); font-size: 0.85rem; margin-bottom: 0.75rem; color: #9a3412;">
                            {% if is_full %}
                                🔒 <strong>Currently full.</strong> All {{ listing.capacity }} spots are taken.
                            {% else %}
                                🏠 <strong>Already occupied</strong> by {{ occupied_count }} of {{ listing.capacity }} tenant(s). Contact the current tenant for availability.
                            {% endif %}
                        </div>

                        <button type="button" class="btn btn-primary" style="width: 100%; margin-bottom: 0.5rem;"
                                onclick="if(window.chatWidget){chatWidget.openConversationWith({{ first_tenant.id }}, {{ listing.id }})}">
                            💬 Contact Tenant ({{ first_tenant.fullName }})
                        </button>
                    {% elseif viewer_is_tenant %}
                        {# The viewer already signed here — don't let them re-contract or spam the owner about their own rental. #}
                        <div style="padding: 0.75rem 1rem; background: #ecfdf5; border: 1px solid #a7f3d0; border-radius: var(--radius-lg); font-size: 0.85rem; margin-bottom: 0.75rem; color: #065f46;">
                            ✅ You are currently renting this property.
                        </div>
                    {% else %}
                        {% if not has_subscription %}
                            <a href="{{ path('subscription_index') }}" class="btn btn-primary" style="width: 100%; margin-bottom: 0.5rem;">
                                💬 Contact Owner <span style="opacity:0.85;font-weight:500;margin-left:0.35rem;">(Subscribe first)</span>
                            </a>
                            <a href="{{ path('subscription_index') }}" class="btn btn-secondary" style="width: 100%; margin-bottom: 0.5rem; background: #9ca3af; color: white; border-color: #9ca3af;">
                                📝 Generate Contract <span style="opacity:0.9;font-weight:500;margin-left:0.35rem;">(Subscribe first)</span>
                            </a>
                        {% else %}
                            <button type="button" class="btn btn-primary" style="width: 100%; margin-bottom: 0.5rem;"
                                    onclick="if(window.chatWidget){chatWidget.openConversationWith({{ listing.owner.id }}, {{ listing.id }})}">
                                💬 Contact Owner
                            </button>

                            {% if is_granted('ROLE_STUDENT') %}
                            <button type="button" class="btn btn-secondary" style="width: 100%; margin-bottom: 0.5rem; background: #28a745; color: white; border-color: #28a745;"
                                    onclick="document.getElementById('contractSetupModal').classList.add('active')">
                                📝 Generate Contract
                            </button>
                            {% endif %}
                        {% endif %}
                    {% endif %}

                    <form method="post" action="{{ path('listing_save', {id: listing.id}) }}" style="margin-bottom: 0.5rem;">
                        <input type="hidden" name="_token" value="{{ csrf_token('save'~listing.id) }}">
                        <button type="submit" class="btn btn-outline" style="width: 100%;">{{ is_saved is defined and is_saved ? '❤️ Saved' : '🤍 Save Listing' }}</button>
                    </form>

                    <button type="button" class="btn btn-outline" style="width: 100%; margin-bottom: 0.5rem;" onclick="shareListing()">
                        📤 Share Listing
                    </button>

                    <button type="button" class="btn btn-outline" style="width: 100%; color: #dc3545; border-color: #dc3545;" onclick="document.getElementById('reportModal').classList.add('active')">
                        🚩 Report Listing
                    </button>
                {% endif %}

                {% if is_granted('ROLE_OWNER') and app.user == listing.owner %}
                    <div id="priceSuggestionWidget" style="margin-bottom:0.75rem;">
                        <button type="button" onclick="loadPriceSuggestion()" id="priceBtn" class="btn btn-outline" style="width:100%;font-size:0.85rem;">💡 Get AI Price Suggestion</button>
                        <div id="priceSuggestionContent"></div>
                    </div>
                    <a href="{{ path('listing_edit', {id: listing.id}) }}" class="btn btn-primary" style="width: 100%; margin-bottom: 0.5rem;">✏️ Edit Listing</a>
                    <form method="post" action="{{ path('listing_delete', {id: listing.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete'~listing.id) }}">
                        <button type="submit" class="btn btn-danger" style="width: 100%;" onclick="return confirm('Are you sure you want to remove this listing?')">🗑 Remove</button>
                    </form>
                {% endif %}
            </div>
        </div>
    </div>
</main>

<!-- Lightbox Overlay -->
<div class="lightbox-overlay" id="lightbox">
    <button class="lightbox-close" onclick="closeLightbox()">&times;</button>
    <button class="lightbox-nav lightbox-prev" onclick="lightboxNav(-1)">&#8249;</button>
    <img id="lightboxImage" src="" alt="">
    <button class="lightbox-nav lightbox-next" onclick="lightboxNav(1)">&#8250;</button>
    <div class="lightbox-counter" id="lightboxCounter"></div>
</div>

{% if is_granted('ROLE_STUDENT') and app.user is not null and app.user != listing.owner %}
<!-- Contract Setup Modal -->
<div class="modal-overlay" id="contractSetupModal">
    <div class="modal">
        <div class="modal-header">
            <h3>Paramètres du Contrat</h3>
            <button class="modal-close" onclick="document.getElementById('contractSetupModal').classList.remove('active')">&times;</button>
        </div>
        <div class="modal-body">
            <p class="text-muted" style="margin: 0 0 1.25rem;">Veuillez définir la durée et la date de début de votre location.</p>

            <form method="post" action="{{ path('contract_generate_from_listing', {id: listing.id}) }}" id="contractSetupForm">
                <div class="form-group" style="margin-bottom: 1rem;">
                    <label class="form-label" for="csStartMonth" style="font-weight: 600;">Mois de début</label>
                    <input type="month" name="startMonth" class="form-input" id="csStartMonth" required min="{{ "now"|date("Y-m") }}" value="{{ "+1 month"|date("Y-m") }}" style="width:100%; padding:10px 12px; border:1px solid var(--color-border); border-radius: var(--radius-md);">
                    <p class="text-small text-muted" style="margin-top: 0.35rem; font-size: 0.8rem;">La location commencera le 1er du mois sélectionné.</p>
                </div>

                <div class="form-group" style="margin-bottom: 1.75rem;">
                    <label class="form-label" for="csDuration" style="font-weight: 600;">Durée (Mois)</label>
                    <select name="duration" class="form-input" id="csDuration" required style="width:100%; padding:10px 12px; border:1px solid var(--color-border); border-radius: var(--radius-md);">
                        {% for i in 1..12 %}
                            <option value="{{ i }}" {{ i == 9 ? 'selected' }}>{{ i }} mois</option>
                        {% endfor %}
                    </select>
                </div>

                <button type="submit" class="btn btn-primary" style="width: 100%;">Générer le Contrat</button>
            </form>
        </div>
    </div>
</div>

<!-- Report Modal -->
<div class="modal-overlay" id="reportModal">
    <div class="modal">
        <div class="modal-header">
            <h3>🚩 Report Listing</h3>
            <button class="modal-close" onclick="document.getElementById('reportModal').classList.remove('active')">&times;</button>
        </div>
        <div class="modal-body">
            <form id="reportForm">
                <div class="form-group" style="margin-bottom: 1rem;">
                    <label class="form-label" style="font-weight: 600;">Reason</label>
                    <select class="form-input" id="reportReason" required style="width:100%; padding:10px 12px; border:1px solid var(--color-border); border-radius: var(--radius-md);">
                        <option value="">Select a reason...</option>
                        <option value="scam_fraud">Scam / Fraud</option>
                        <option value="inappropriate_content">Inappropriate Content</option>
                        <option value="fake_listing">Fake Listing</option>
                        <option value="other">Other</option>
                    </select>
                </div>
                <div class="form-group" style="margin-bottom: 1rem;">
                    <label class="form-label" style="font-weight: 600;">Details</label>
                    <textarea class="form-input" id="reportDescription" rows="4" placeholder="Describe the issue..." required style="width:100%; padding:10px 12px; border:1px solid var(--color-border); border-radius: var(--radius-md);"></textarea>
                </div>
                <button type="submit" class="btn btn-danger" style="width: 100%;">Submit Report</button>
            </form>
        </div>
    </div>
</div>
{% endif %}

{% endblock %}

{% block javascripts %}
<script src="https://unpkg.com/leaflet-routing-machine@3.2.12/dist/leaflet-routing-machine.js"></script>
<script src="/js/voice-navigation.js"></script>
<script>
// Image gallery data
var images = [
    {% for img in listing.images %}
    "{{ img.imagePath starts with 'http' ? img.imagePath : '/uploads/listings/' ~ img.imagePath }}"{% if not loop.last %},{% endif %}
    {% endfor %}
];
var currentImageIndex = 0;

function selectImage(index) {
    currentImageIndex = index;
    document.getElementById('mainImage').src = images[index];
    document.querySelectorAll('.thumb-pro').forEach(function(t, i) {
        t.classList.toggle('active', i === index);
    });
    var counter = document.getElementById('galleryCounter');
    if (counter) counter.textContent = (index + 1) + ' / ' + images.length + ' Photos';
}

// Lightbox
function openLightbox(index) {
    if (images.length === 0) return;
    currentImageIndex = index;
    document.getElementById('lightboxImage').src = images[index];
    document.getElementById('lightboxCounter').textContent = (index + 1) + ' / ' + images.length;
    document.getElementById('lightbox').classList.add('active');
}
function closeLightbox() {
    document.getElementById('lightbox').classList.remove('active');
}
function lightboxNav(dir) {
    currentImageIndex = (currentImageIndex + dir + images.length) % images.length;
    document.getElementById('lightboxImage').src = images[currentImageIndex];
    document.getElementById('lightboxCounter').textContent = (currentImageIndex + 1) + ' / ' + images.length;
}
document.addEventListener('keydown', function(e) {
    if (!document.getElementById('lightbox').classList.contains('active')) return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft') lightboxNav(-1);
    if (e.key === 'ArrowRight') lightboxNav(1);
});

// Map + Trajectory — powered by Leaflet Routing Machine
{% if listing.latitude and listing.longitude %}
var MapCtl = {
    map:            null,
    listingLat:     {{ listing.latitude }},
    listingLng:     {{ listing.longitude }},
    listingMarker:  null,
    facultyMarker:  null,
    routingControl: null,   // LRM control instance
    lastRoute:      null,   // stored for VoiceNav
    faculties:      [],
    travelMode:     'driving',
    selectedFaculty: null,

    init: function() {
        this.map = L.map('listingMap').setView([this.listingLat, this.listingLng], 13);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '© OpenStreetMap contributors', maxZoom: 19
        }).addTo(this.map);

        var houseIcon = L.divIcon({
            className: 'custom-marker',
            html: '<div style="background:#6366f1;width:42px;height:42px;border-radius:50%;display:flex;align-items:center;justify-content:center;color:white;font-size:20px;box-shadow:0 4px 10px rgba(0,0,0,0.3);border:3px solid white;">🏠</div>',
            iconSize: [42, 42], iconAnchor: [21, 21]
        });
        this.listingMarker = L.marker([this.listingLat, this.listingLng], { icon: houseIcon })
            .addTo(this.map)
            .bindPopup('<strong>{{ listing.title|e('js') }}</strong><br>{{ listing.address|e('js') }}<br><b style="color:#6366f1">{{ listing.price }} TND/mo</b>')
            .openPopup();

        setTimeout(function() { MapCtl.map.invalidateSize(); }, 150);
        this.loadFaculties();
    },

    loadFaculties: function() {
        fetch('/api/faculties', { credentials: 'same-origin' })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                MapCtl.faculties = Array.isArray(data) ? data : (data.faculties || []);
                var sel = document.getElementById('facultySelector');
                var byGov = {};
                MapCtl.faculties.forEach(function(f) {
                    var g = f.governorate || 'Other';
                    if (!byGov[g]) byGov[g] = [];
                    byGov[g].push(f);
                });
                Object.keys(byGov).sort().forEach(function(g) {
                    var grp = document.createElement('optgroup');
                    grp.label = g;
                    byGov[g].forEach(function(f) {
                        var o = document.createElement('option');
                        o.value = f.id;
                        o.textContent = f.name + (f.city ? ' — ' + f.city : '');
                        grp.appendChild(o);
                    });
                    sel.appendChild(grp);
                });
                sel.addEventListener('change', function() {
                    var id = parseInt(this.value);
                    MapCtl.selectedFaculty = MapCtl.faculties.find(function(f) { return f.id === id; }) || null;
                    document.getElementById('getDirectionsBtn').disabled = !MapCtl.selectedFaculty;
                });
                document.getElementById('getDirectionsBtn').addEventListener('click', function() {
                    if (MapCtl.selectedFaculty) MapCtl.calculateRoute();
                });
            })
            .catch(function(err) { console.error('Failed to load faculties:', err); });
    },

    clearRoutes: function() {
        // Remove existing LRM control (removes route lines + itinerary)
        if (this.routingControl) {
            this.map.removeControl(this.routingControl);
            this.routingControl = null;
        }
        if (this.facultyMarker) {
            this.map.removeLayer(this.facultyMarker);
            this.facultyMarker = null;
        }
        document.getElementById('routeInfo').classList.remove('active');
        document.getElementById('routeStepsPanel').classList.remove('active');
        document.getElementById('routeStepsList').innerHTML = '';
        this.lastRoute = null;

        // Hide voice nav launch button and reset nav state
        var voiceBtn = document.getElementById('startVoiceNavBtn');
        if (voiceBtn) voiceBtn.style.display = 'none';
        if (typeof VoiceNav !== 'undefined') VoiceNav.reset();
    },

    calculateRoute: function() {
        var f = this.selectedFaculty;
        if (!f || !f.latitude || !f.longitude) { alert('This faculty has no coordinates.'); return; }

        this.clearRoutes();

        // Faculty marker (green 🎓)
        var facultyIcon = L.divIcon({
            className: 'custom-marker',
            html: '<div style="background:#10b981;width:42px;height:42px;border-radius:50%;display:flex;align-items:center;justify-content:center;color:white;font-size:20px;box-shadow:0 4px 10px rgba(0,0,0,0.3);border:3px solid white;">🎓</div>',
            iconSize: [42, 42], iconAnchor: [21, 21]
        });
        this.facultyMarker = L.marker([f.latitude, f.longitude], { icon: facultyIcon })
            .addTo(this.map)
            .bindPopup('<strong>' + f.name + '</strong>');

        var btn = document.getElementById('getDirectionsBtn');
        btn.disabled = true;
        btn.innerHTML = '<span>⏳</span> Calculating...';

        var isWalking  = this.travelMode === 'walking';
        var serviceUrl = isWalking
            ? 'https://routing.openstreetmap.de/routed-foot/route/v1'
            : 'https://router.project-osrm.org/route/v1';
        var profile    = isWalking ? 'foot' : 'driving';
        var self       = this;

        this.routingControl = L.Routing.control({
            waypoints: [
                L.latLng(f.latitude,       f.longitude),
                L.latLng(this.listingLat,  this.listingLng)
            ],
            router: L.Routing.osrmv1({
                serviceUrl: serviceUrl,
                profile:    profile,
                useHints:   false
            }),
            // We render instructions ourselves — hide the default LRM panel
            show:            false,
            addWaypoints:    false,
            routeWhileDragging: false,
            fitSelectedRoutes: true,
            showAlternatives: true,
            // Suppress LRM's own markers; we already have custom ones
            createMarker: function() { return null; },
            lineOptions: {
                styles: [{ color: '#6366f1', weight: 7, opacity: 0.92 }],
                extendToWaypoints: true,
                missingRouteTolerance: 10
            },
            altLineOptions: {
                styles: [{ color: '#94a3b8', weight: 4, opacity: 0.5, dashArray: '8 8' }],
                extendToWaypoints: false,
                missingRouteTolerance: 10
            }
        }).addTo(this.map);

        // ── On route found: fill summary bar + step-by-step panel ──────
        this.routingControl.on('routesfound', function(e) {
            btn.disabled = false;
            btn.innerHTML = '<span id="transportEmoji">' + (self.travelMode === 'walking' ? '🚶' : '🚗') + '</span> Get route';

            var r    = e.routes[0];
            var km   = (r.summary.totalDistance / 1000).toFixed(1) + ' km';
            var mins = Math.round(r.summary.totalTime / 60);
            var dur  = mins < 60 ? mins + ' min' : Math.floor(mins / 60) + 'h ' + (mins % 60) + 'min';

            document.getElementById('routeDistance').textContent = km;
            document.getElementById('routeDuration').textContent = dur;
            document.getElementById('routeInfo').classList.add('active');

            // Turn-by-turn steps
            var list = document.getElementById('routeStepsList');
            var html = '';
            (r.instructions || []).forEach(function(step) {
                if (!step.text) return;
                var d = step.distance >= 1000
                    ? (step.distance / 1000).toFixed(1) + ' km'
                    : Math.round(step.distance) + ' m';
                html += '<li><span class="step-text">' + step.text + '</span>'
                      + '<span class="step-dist">' + d + '</span></li>';
            });
            list.innerHTML = html;
            document.getElementById('routeStepsPanel').classList.add('active');

            // ── Voice Navigation: store route + show launch button ───────
            self.lastRoute = r;
            var voiceBtn = document.getElementById('startVoiceNavBtn');
            if (voiceBtn) voiceBtn.style.display = 'inline-block';
            if (typeof VoiceNav !== 'undefined') {
                VoiceNav.prepare(r);
            }
        });

        this.routingControl.on('routingerror', function() {
            btn.disabled = false;
            btn.innerHTML = '<span id="transportEmoji">' + (self.travelMode === 'walking' ? '🚶' : '🚗') + '</span> Get route';
            alert('Could not calculate route. Please try again.');
        });
    }
};

function setTravelMode(mode) {
    MapCtl.travelMode = mode;
    document.getElementById('modeDriving').classList.toggle('active', mode === 'driving');
    document.getElementById('modeWalking').classList.toggle('active', mode === 'walking');
    var emoji = document.getElementById('transportEmoji');
    if (emoji) emoji.textContent = mode === 'walking' ? '🚶' : '🚗';
    if (MapCtl.selectedFaculty) MapCtl.calculateRoute();
}

document.addEventListener('DOMContentLoaded', function() { MapCtl.init(); });
{% endif %}

// Close contract setup modal when clicking the overlay background
(function() {
    var overlay = document.getElementById('contractSetupModal');
    if (!overlay) return;
    overlay.addEventListener('click', function(e) {
        if (e.target === overlay) overlay.classList.remove('active');
    });
})();

// Share
function shareListing() {
    var url = window.location.href;
    if (navigator.share) {
        navigator.share({ title: '{{ listing.title|e('js') }}', url: url });
    } else {
        navigator.clipboard.writeText(url).then(function() { alert('Link copied to clipboard!'); });
    }
}

// Report
(function() {
    var form = document.getElementById('reportForm');
    if (!form) return;
    form.onsubmit = function(e) {
        e.preventDefault();
        fetch('/api/reports', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'same-origin',
            body: JSON.stringify({
                report_type: 'listing',
                reported_listing_id: {{ listing.id }},
                reason: document.getElementById('reportReason').value,
                description: document.getElementById('reportDescription').value
            })
        }).then(function(r) { return r.json(); }).then(function() {
            alert('Thank you. Your report has been submitted.');
            document.getElementById('reportModal').classList.remove('active');
        }).catch(function() { alert('Failed to submit report.'); });
    };
})();

// ── AI: Listing Quality Score ──
function loadAiScore() {
    var btn = document.getElementById('aiAnalyzeBtn');
    var box = document.getElementById('aiQualityContent');
    btn.disabled = true;
    btn.textContent = 'Analyzing…';
    fetch('/api/listings/{{ listing.id }}/optimization-score', { credentials: 'same-origin' })
        .then(function(r) { return r.json(); })
        .then(function(d) {
            btn.textContent = 'Re-analyze';
            btn.disabled = false;
            var score = d.quality_score || d.score || 0;
            var tier  = score >= 80 ? '#10b981' : score >= 55 ? '#f59e0b' : '#ef4444';
            var tier_label = score >= 80 ? 'Excellent' : (score >= 55 ? 'Good' : 'Needs improvement');
            var html  = '<div style="display:flex;align-items:center;gap:1rem;margin-bottom:1rem;">';
            html += '<div class="ai-score-ring" style="background:' + tier + ';">' + score + '</div>';
            html += '<div><div style="font-weight:700;font-size:1rem;">Quality Score: ' + score + '/100</div>';
            html += '<div style="font-size:0.82rem;color:var(--color-text-muted);">' + tier_label + '</div></div></div>';
            if (d.issues && d.issues.length) {
                html += '<div style="margin-bottom:0.75rem;"><strong style="font-size:0.85rem;">Issues to fix:</strong>';
                d.issues.forEach(function(i) { html += '<div class="ai-issue"><span>⚠️</span><span>' + i + '</span></div>'; });
                html += '</div>';
            }
            if (d.suggestions && d.suggestions.length) {
                html += '<div><strong style="font-size:0.85rem;">Suggestions:</strong>';
                d.suggestions.forEach(function(s) { html += '<div class="ai-suggestion">💡 ' + s + '</div>'; });
                html += '</div>';
            }
            box.innerHTML = html;
        })
        .catch(function() {
            btn.disabled = false;
            btn.textContent = 'Retry';
            box.innerHTML = '<p style="color:#ef4444;font-size:0.85rem;">Could not load AI score. Please try again.</p>';
        });
}

// ── AI: Price Suggestion ──
function loadPriceSuggestion() {
    var btn = document.getElementById('priceBtn');
    var box = document.getElementById('priceSuggestionContent');
    btn.disabled = true;
    btn.textContent = 'Loading…';
    fetch('/api/listings/{{ listing.id }}/price-suggestion', { credentials: 'same-origin' })
        .then(function(r) { return r.json(); })
        .then(function(d) {
            btn.style.display = 'none';
            var price = d.recommended_price || d.suggested_price || 0;
            var min   = d.min || d.price_min || 0;
            var max   = d.max || d.price_max || 0;
            var html  = '<div style="background:linear-gradient(100deg,#eef2ff,#f5f3ff);border:1px solid #c7d2fe;border-radius:var(--radius-lg);padding:0.85rem;font-size:0.85rem;margin-top:0.5rem;">';
            html += '<div style="font-weight:700;color:var(--color-brand);font-size:1rem;">💡 Suggested: ' + price + ' TND/mo</div>';
            if (min && max) { html += '<div style="color:#4b5563;margin-top:2px;">Market range: ' + min + ' – ' + max + ' TND</div>'; }
            if (d.rationale || d.reasoning) { html += '<div style="margin-top:0.35rem;color:#374151;">' + (d.rationale || d.reasoning) + '</div>'; }
            html += '</div>';
            box.innerHTML = html;
        })
        .catch(function() {
            btn.disabled = false;
            btn.textContent = '💡 Get AI Price Suggestion';
        });
}
</script>
{% endblock %}
