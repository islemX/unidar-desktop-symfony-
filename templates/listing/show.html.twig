// ── AI: Lease Analyzer ──
function analyzeLease() {
    var text = document.getElementById('leaseText').value.trim();
    var box  = document.getElementById('leaseResult');
    if (!text) { alert('Please paste your lease text first.'); return; }
    box.style.display = 'block';
    box.innerHTML = '<div style="text-align:center;padding:1.5rem;color:var(--color-text-muted);">📋 Analyzing your lease…</div>';
    fetch('/api/ai/lease/analyze', {
        method: 'POST', credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ text: text })
    }).then(function(r) { return r.json(); })
    .then(function(d) {
        var score = d.risk_score || 0;
        var level = score >= 70 ? 'High Risk' : score >= 40 ? 'Medium Risk' : 'Low Risk';
        var col = score >= 70 ? '#ef4444' : score >= 40 ? '#f59e0b' : '#10b981';
        var flags = d.flags || [];
        var rec = d.recommendations || [];
        var html = '<div style="background:#fff;border:1px solid var(--color-border);border-radius:var(--radius-lg);padding:1rem;font-size:0.84rem;">';
        html += '<div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:0.75rem;">';
        html += '<div style="width:50px;height:50px;border-radius:50%;background:' + col + ';color:white;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:1rem;flex-shrink:0;">' + score + '</div>';
        html += '<div><div style="font-weight:700;color:' + col + ';">' + level + '</div><div style="font-size:0.77rem;color:#64748b;">Lease risk score</div></div></div>';
        if (flags.length) {
            html += '<div style="font-weight:700;margin-bottom:0.35rem;">🚩 Risk flags:</div>';
            flags.forEach(function(f) { html += '<div style="padding:4px 0;border-bottom:1px solid #f1f5f9;color:#374151;">⚠️ ' + (f.description||f) + '</div>'; });
        }
        if (rec.length) {
            html += '<div style="font-weight:700;margin:0.6rem 0 0.35rem;">💡 Recommendations:</div>';
            rec.forEach(function(r) { html += '<div style="padding:3px 0;color:#374151;">→ ' + r + '</div>'; });
        }
        html += '</div>';
        box.innerHTML = html;
    })
    .catch(function() { box.innerHTML = '<p style="color:#ef4444;">Analysis failed. Please try again.</p>'; });
}

// ── AI: Description Generator ──
var _descLang = 'en';
var _descCache = {};
function setDescLang(lang) {
    _descLang = lang;
    ['en','fr','ar'].forEach(function(l) {
        var el = document.getElementById('descLang' + l.charAt(0).toUpperCase() + l.slice(1));
        if (el) el.classList.toggle('active', l === lang);
    });
    if (_descCache[lang]) {
        document.getElementById('aiDescText').textContent = _descCache[lang];
        document.getElementById('aiDescContent').style.display = 'block';
    }
}
function generateDescription() {
    var loading = document.getElementById('aiDescLoading');
    var content = document.getElementById('aiDescContent');
    var textEl  = document.getElementById('aiDescText');
    loading.style.display = 'block'; content.style.display = 'none';
    fetch('/api/ai/listing/{{ listing.id }}/description?lang=' + _descLang, { credentials: 'same-origin' })
        .then(function(r) { return r.json(); })
        .then(function(d) {
            loading.style.display = 'none';
            if (d.error) {
                textEl.textContent = '';
                textEl.style.color = '#ef4444';
                textEl.textContent = '⚠ ' + d.error;
                content.style.display = 'block';
                return;
            }
            textEl.style.color = '';
            var text = d.description || d.text || d[_descLang] || '';
            if (!text && d.descriptions) text = d.descriptions[_descLang] || '';
            _descCache[_descLang] = text;
            textEl.textContent = text || 'No description generated — try again.';
            content.style.display = 'block';
        })
        .catch(function(err) {
            loading.style.display = 'none';
            textEl.style.color = '#ef4444';
            textEl.textContent = '⚠ Could not reach the description service. Check that the server is running.';
            content.style.display = 'block';
        });
}
function copyDescription() {
    var text = document.getElementById('aiDescText').textContent;
    if (text) navigator.clipboard.writeText(text).then(function() { alert('Copied to clipboard!'); });
}

// ── AI: Photo Quality (auto-load for owner) ──
(function() {
    {% if is_granted('ROLE_OWNER') and app.user == listing.owner %}
    fetch('/api/ai/listing/{{ listing.id }}/photo-quality', { credentials: 'same-origin' })
        .then(function(r) { return r.json(); })
        .then(function(d) {
            var badge = document.getElementById('photoQualityBadge');
            if (!badge) return;
            var grade = d.overall_grade || d.grade || 'C';
            var colors = { A:'#10b981', B:'#84cc16', C:'#f59e0b', D:'#f97316', F:'#ef4444' };
            var col = colors[grade] || '#6366f1';
            badge.style.background = col;
            badge.textContent = grade;
            badge.title = 'Photo quality: Grade ' + grade + ' (' + (d.overall_score || 0) + '/100)';
            badge.style.display = 'flex';
        })
        .catch(function() {});
    {% endif %}
})();

// ── Panel toggle helper ──
function togglePanel(bodyId, toggleId) {
    var body = document.getElementById(bodyId);
    var tog  = document.getElementById(toggleId);
    if (!body) return;
    var collapsed = body.classList.toggle('collapsed');
    if (tog) tog.textContent = collapsed ? 'Load ↓' : 'Hide ↑';
}
</script>
{% endblock %}
