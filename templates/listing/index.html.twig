{% extends 'base.html.twig' %}
{% block voice_briefing %}
<script>window.__vcPage__ = { page: 'listings', itemCount: {{ listings is defined ? listings|length : 0 }}, role: '{{ app.user ? (is_granted("ROLE_OWNER") ? "owner" : "student") : "guest" }}', briefing: { en: "Listings page. {{ listings is defined ? listings|length : 0 }} properties found. Say 'search city' or 'under 500' to filter.", fr: "Annonces. {{ listings is defined ? listings|length : 0 }} logements. Dites 'chercher ville' ou 'moins de 500'.", ar: "صفحة الإعلانات. {{ listings is defined ? listings|length : 0 }} عقار متاح. قل 'ابحث مدينة' أو 'أقل من 500'." }, suggestions: [ {label:'Search in Tunis', cmd:'search Tunis'}, {label:'Under 500 TND', cmd:'under 500'}, {label:'Apartments only', cmd:'search apartment'}, {label:'Open first listing', cmd:'open the first one'} ] };</script>
{% endblock %}
{% block title %}Browse Listings - UNIDAR{% endblock %}

{% block stylesheets %}
<style>
    .listings-grid { display:grid; gap:1.5rem; grid-template-columns:repeat(auto-fill,minmax(300px,1fr)); }
    .card-image-wrapper { position:relative; height:220px; overflow:hidden; }
    .card-image-wrapper img { width:100%; height:100%; object-fit:cover; transition:transform 0.5s ease; }
    .listing-card:hover .card-image-wrapper img { transform:scale(1.05); }
    .price-tag { font-size:1.25rem; font-weight:800; color:var(--color-brand); }
    .badge-type { position:absolute; top:12px; left:12px; background:rgba(255,255,255,0.92); backdrop-filter:blur(8px); color:var(--color-surface-800); padding:4px 12px; border-radius:50px; font-size:0.75rem; font-weight:600; border:1px solid rgba(255,255,255,0.5); }

    /* Filter panel (PHP look) */
    .filter-panel-pro { background: white; border: 1px solid var(--color-surface-100); border-radius: var(--radius-2xl); padding: 1.75rem; box-shadow: var(--shadow-sm); margin-bottom: 1.5rem; }
    .filter-panel-pro .grid-filters { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 1rem; }
    .filter-panel-pro .form-label { display: block; font-size: 0.8rem; font-weight: 700; color: var(--color-surface-700); text-transform: uppercase; letter-spacing: 0.04em; margin-bottom: 0.35rem; }
    .filter-panel-pro .form-input { width: 100%; padding: 10px 12px; border: 1px solid var(--color-border); border-radius: var(--radius-md); font-size: 0.95rem; background: white; }
    .filter-panel-pro .form-input:focus { border-color: var(--color-brand); outline: none; box-shadow: 0 0 0 3px rgba(99,102,241,0.1); }

    /* View toggles */
    .view-toggle { display: inline-flex; background: var(--color-surface-50); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: 4px; gap: 4px; }
    .view-toggle button { border: none; background: transparent; padding: 8px 16px; border-radius: var(--radius-md); cursor: pointer; font-size: 0.88rem; font-weight: 600; color: var(--color-text-muted); transition: all 0.2s; }
    .view-toggle button.active { background: white; color: var(--color-brand); box-shadow: 0 2px 6px rgba(0,0,0,0.06); }

    /* Map */
    #listingsMap { height: 600px; border-radius: var(--radius-xl); overflow: hidden; border: 1px solid var(--color-border); box-shadow: 0 10px 25px -5px rgba(0,0,0,0.08); }
    .map-popup-card { min-width: 200px; }
    .map-popup-card img { width: 100%; height: 100px; object-fit: cover; border-radius: 8px; margin-bottom: 6px; }
    .map-popup-card strong { display: block; font-size: 0.95rem; margin-bottom: 2px; }
    .map-popup-card .price { color: var(--color-brand); font-weight: 800; }
    .map-popup-card a { display: inline-block; margin-top: 6px; font-size: 0.8rem; color: var(--color-brand); }
</style>
{% endblock %}

{% block body %}
<div class="floating-shapes"><div class="shape shape-1"></div><div class="shape shape-2"></div></div>

<main style="padding:2.5rem 0 4rem;">
    <div class="container">
        <div class="section-header-pro fade-in-up" style="margin-bottom:1.5rem;">
            <span class="section-tag" data-i18n="listings_marketplace">Marketplace</span>
            <div style="display:flex;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;gap:1rem;">
                <div>
                    <h1 class="title-pro" data-i18n="listings_title">Find Your Perfect Home</h1>
                    <p class="text-muted" style="margin-top:0.5rem;">Browse verified student housing across Tunisia.</p>
                </div>
                <div style="display: flex; align-items: center; gap: 0.75rem;">
                    <div class="view-toggle" role="tablist" aria-label="View mode">
                        <button type="button" id="viewGridBtn" class="active" onclick="setView('grid')">🔲 Grid</button>
                        <button type="button" id="viewMapBtn" onclick="setView('map')">🗺️ Map</button>
                    </div>
                    {% if is_granted('ROLE_OWNER') %}
                        <a href="{{ path('listing_new') }}" class="btn btn-primary">+ Add Listing</a>
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="filter-panel-pro fade-in-up stagger-1">
            {{ form_start(filter_form, {'method': 'GET', 'action': path('listing_index'), 'attr': {'style': 'margin:0'}}) }}
            <div class="grid-filters">
                <div>
                    <label class="form-label" data-i18n="filter_min_price">Min Price (TND)</label>
                    {{ form_widget(filter_form.minPrice, {'attr': {'class': 'form-input', 'placeholder': 'e.g. 200'}}) }}
                </div>
                <div>
                    <label class="form-label" data-i18n="filter_max_price">Max Price (TND)</label>
                    {{ form_widget(filter_form.maxPrice, {'attr': {'class': 'form-input', 'placeholder': 'e.g. 1200'}}) }}
                </div>
                <div>
                    <label class="form-label" data-i18n="filter_bedrooms">Bedrooms</label>
                    {{ form_widget(filter_form.bedrooms, {'attr': {'class': 'form-input'}}) }}
                </div>
                <div>
                    <label class="form-label" data-i18n="filter_property_type">Property Type</label>
                    {{ form_widget(filter_form.propertyType, {'attr': {'class': 'form-input'}}) }}
                </div>
                <div>
                    <label class="form-label">Gender</label>
                    {{ form_widget(filter_form.genderPreference, {'attr': {'class': 'form-input'}}) }}
                </div>
            </div>
            <div style="display:flex; justify-content: flex-end; margin-top: 1.25rem; gap: 0.75rem;">
                <a href="{{ path('listing_index') }}" class="btn btn-secondary btn-sm">Clear</a>
                <button type="submit" class="btn btn-primary hover-lift" data-i18n="btn_apply_filters">Apply Filters</button>
            </div>
            {{ form_end(filter_form) }}
        </div>

        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1.25rem;">
            <p style="color:var(--color-text-muted);font-size:0.9rem;">
                <strong style="color:var(--color-surface-900);">{{ listings.getTotalItemCount() }}</strong> listings found
            </p>
        </div>

        {# Grid view #}
        <div id="gridView">
            {% if listings|length == 0 %}
                <div class="card premium-card text-center" style="padding:4rem;">
                    <div style="font-size:4rem;margin-bottom:1rem;">🏠</div>
                    <h3 style="margin-bottom:0.5rem;">No listings found</h3>
                    <p class="text-muted">Try adjusting your filters or check back later.</p>
                </div>
            {% else %}
                <div class="listings-grid">
                    {% for listing in listings %}
                        {% include 'listing/_card.html.twig' %}
                    {% endfor %}
                </div>
                <div class="pagination" style="margin-top: 2rem;">{{ knp_pagination_render(listings) }}</div>
            {% endif %}
        </div>

        {# Map view #}
        <div id="mapView" style="display: none;">
            <div id="listingsMap"></div>
        </div>
    </div>
</main>

<script>
    var _listingsData = [
        {% for listing in listings %}
            {% if listing.latitude and listing.longitude %}
            {
                id: {{ listing.id }},
                title: {{ listing.title|json_encode|raw }},
                address: {{ listing.address|json_encode|raw }},
                price: {{ listing.price }},
                lat: {{ listing.latitude }},
                lng: {{ listing.longitude }},
                image: {% if listing.images is not empty %}{{ ('/uploads/listings/' ~ listing.images.first.imagePath)|json_encode|raw }}{% else %}null{% endif %},
                url: {{ path('listing_show', {id: listing.id})|json_encode|raw }}
            }{% if not loop.last %},{% endif %}
            {% endif %}
        {% endfor %}
    ];
    var _listingsMap = null;

    function setView(mode) {
        var grid = document.getElementById('gridView');
        var map = document.getElementById('mapView');
        var gBtn = document.getElementById('viewGridBtn');
        var mBtn = document.getElementById('viewMapBtn');
        if (mode === 'map') {
            grid.style.display = 'none';
            map.style.display = 'block';
            gBtn.classList.remove('active');
            mBtn.classList.add('active');
            initListingsMap();
        } else {
            grid.style.display = 'block';
            map.style.display = 'none';
            mBtn.classList.remove('active');
            gBtn.classList.add('active');
        }
    }

    function initListingsMap() {
        if (_listingsMap) {
            setTimeout(function() { _listingsMap.invalidateSize(); }, 100);
            return;
        }
        _listingsMap = L.map('listingsMap').setView([36.8065, 10.1815], 11);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '© OpenStreetMap contributors', maxZoom: 19
        }).addTo(_listingsMap);

        if (_listingsData.length === 0) return;

        var bounds = [];
        _listingsData.forEach(function(l) {
            var priceIcon = L.divIcon({
                className: 'price-marker',
                html: '<div style="background: var(--color-brand, #6366f1); color: white; padding: 4px 10px; border-radius: 50px; font-weight: 700; font-size: 0.8rem; box-shadow: 0 4px 10px rgba(0,0,0,0.25); white-space: nowrap; border: 2px solid white;">' + l.price + ' TND</div>',
                iconSize: [null, null],
                iconAnchor: [30, 12]
            });
            var m = L.marker([l.lat, l.lng], { icon: priceIcon }).addTo(_listingsMap);
            var imgHtml = l.image ? '<img src="' + l.image + '" alt="">' : '';
            m.bindPopup(
                '<div class="map-popup-card">' + imgHtml +
                '<strong>' + l.title + '</strong>' +
                '<div style="font-size: 0.8rem; color: #64748b;">' + l.address + '</div>' +
                '<div class="price">' + l.price + ' TND/mo</div>' +
                '<a href="' + l.url + '">View details →</a>' +
                '</div>'
            );
            bounds.push([l.lat, l.lng]);
        });
        if (bounds.length > 0) _listingsMap.fitBounds(bounds, { padding: [40, 40], maxZoom: 14 });
        setTimeout(function() { _listingsMap.invalidateSize(); }, 200);
    }
</script>
{% endblock %}
