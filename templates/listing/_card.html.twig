<div class="listing-card premium-card hover-lift">
    <div class="card-image-wrapper">
        {% if listing.images is not empty %}
            {% set imgSrc = listing.images.first.imagePath %}
            <img src="{{ imgSrc starts with 'http' ? imgSrc : '/uploads/listings/' ~ imgSrc }}" alt="{{ listing.title }}" loading="lazy">
        {% else %}
            <div class="listing-card-img-placeholder">🏠</div>
        {% endif %}
        <span class="badge-type">{{ listing.propertyType.value|replace({'_': ' '})|title }}</span>
        {% if listing.genderPreference %}
            <span style="position:absolute;top:12px;right:12px;background:rgba(255,255,255,0.92);backdrop-filter:blur(8px);padding:4px 10px;border-radius:50px;font-size:0.72rem;font-weight:600;color:var(--color-surface-700);">
                {{ listing.genderPreference|capitalize }} only
            </span>
        {% endif %}
    </div>
    <div style="padding:1.25rem;">
        <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:0.5rem;">
            <span class="price-tag">{{ listing.price }} TND<span style="font-size:0.85rem;font-weight:500;color:var(--color-text-muted);">/mo</span></span>
        </div>
        <a href="{{ path('listing_show', {id: listing.id}) }}" style="text-decoration:none;color:inherit;">
            <h3 style="font-size:1rem;font-weight:600;margin-bottom:0.35rem;line-height:1.3;color:var(--color-surface-900);">{{ listing.title }}</h3>
        </a>
        <p style="font-size:0.82rem;color:var(--color-text-muted);display:flex;align-items:center;gap:4px;">
            📍 {{ listing.address|slice(0,50) }}{% if listing.address|length > 50 %}…{% endif %}
        </p>
        <div style="display:flex;gap:1rem;margin-top:0.875rem;padding-top:0.875rem;border-top:1px solid var(--color-border);font-size:0.82rem;color:var(--color-surface-600);">
            <span>🛏 {{ listing.bedrooms }} bed{% if listing.bedrooms > 1 %}s{% endif %}</span>
            <span>🚿 {{ listing.bathrooms }} bath</span>
            <span>👥 {{ listing.capacity }} max</span>
        </div>
        <a href="{{ path('listing_show', {id: listing.id}) }}" class="btn btn-primary" style="width:100%;margin-top:1rem;display:block;text-align:center;">
            View Details
        </a>
    </div>
</div>
