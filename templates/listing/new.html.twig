{% extends 'base.html.twig' %}
{% block voice_briefing %}
<script>window.__vcPage__ = { page: 'listing_new', role: 'owner', briefing: { en: "New property form. Fill in all required fields. Say 'start dictation' or 'fill title with...' to use voice input. Say 'submit form' when done.", fr: "Formulaire nouveau logement. Dites 'commencer dictée' ou 'remplis titre avec...' pour saisie vocale.", ar: "نموذج إضافة عقار. قل 'ابدأ الإملاء' أو 'اكتب في العنوان...' للإدخال الصوتي." }, suggestions: [ {label:'Start dictation', cmd:'start dictation'}, {label:'Fill title with...', cmd:'fill title with '}, {label:'Set price to...', cmd:'set price to '}, {label:'Set type to apartment', cmd:'set type to apartment'}, {label:'Next field', cmd:'next field'}, {label:'Submit form', cmd:'submit form'} ] };</script>
{% endblock %}
{% block title %}Add New Property - UNIDAR{% endblock %}

{% block stylesheets %}
<style>
    .property-form-page {
        max-width: 720px;
        margin: 0 auto;
    }
    .form-section-title {
        font-size: 1.5rem;
        font-weight: 700;
        margin: 0 0 var(--space-xs);
    }
    .form-section-sub {
        color: var(--color-text-muted, #6b7280);
        font-size: 0.875rem;
        margin-bottom: var(--space-lg);
    }
    .field-grid-3 {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: var(--space-md);
    }
    .field-grid-2 {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--space-md);
    }
    #propertyMap {
        width: 100%;
        height: 260px;
        border-radius: var(--radius-lg);
        overflow: hidden;
        border: 1px solid var(--color-surface-200, #e5e7eb);
        margin-top: var(--space-sm);
    }
    .image-previews {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(80px, 1fr));
        gap: var(--space-xs);
        margin-top: var(--space-sm);
    }
    .preview-item {
        position: relative;
        aspect-ratio: 1;
        border-radius: var(--radius-md);
        overflow: hidden;
        border: 1px solid var(--color-surface-200, #e5e7eb);
    }
    .preview-item img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .preview-remove {
        position: absolute;
        top: 3px;
        right: 3px;
        background: rgba(0,0,0,0.55);
        color: #fff;
        border: none;
        border-radius: 50%;
        width: 20px;
        height: 20px;
        font-size: 11px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        line-height: 1;
    }
    .required-star { color: var(--color-danger, #ef4444); }
    #mapCoordHint { font-size: 0.78rem; color: var(--color-brand, #6366f1); font-weight: 500; margin-top: 0.3rem; }
    #formAlert {
        display: none;
        border-radius: var(--radius-lg);
        padding: var(--space-sm) var(--space-md);
        margin-bottom: var(--space-md);
    }
    #formAlert.alert-error { background: #fef2f2; color: #b91c1c; border: 1px solid #fca5a5; }
</style>
{% endblock %}

{% block body %}
<div class="container property-form-page">

    {# ── Page header ── #}
    <div class="fade-in-up" style="margin-bottom: var(--space-xl);">
        <div class="section-tag">Management</div>
        <h1 class="form-section-title" style="font-size:2rem; margin-top: var(--space-xs);">Add New Property</h1>
        <p class="form-section-sub">Fill in the details to create a new listing. All fields marked with <span class="required-star">*</span> are required.</p>
    </div>

    <div class="card" style="padding: var(--space-xl);">
        <div id="formAlert"></div>

        {{ form_start(form, {
            'attr': {
                'enctype': 'multipart/form-data',
                'id': 'createListingForm',
                'novalidate': 'novalidate'
            }
        }) }}

        {# ── Title ── #}
        <div class="form-group">
            <label class="form-label" for="{{ form.title.vars.id }}">Title <span class="required-star">*</span></label>
            {{ form_widget(form.title, {'attr': {'class': 'form-input', 'placeholder': 'e.g. Luxury Studio near Campus'}}) }}
            {{ form_errors(form.title) }}
        </div>

        {# ── Description ── #}
        <div class="form-group">
            <label class="form-label" for="{{ form.description.vars.id }}">Description <span class="required-star">*</span></label>
            {{ form_widget(form.description, {'attr': {'class': 'form-input', 'rows': '4', 'placeholder': 'Tell students about the property, nearby facilities, rules...'}}) }}
            {{ form_errors(form.description) }}
        </div>

        {# ── Address + Map ── #}
        <div class="form-group">
            <label class="form-label" for="{{ form.address.vars.id }}">Address <span class="required-star">*</span></label>
            {{ form_widget(form.address, {'attr': {'class': 'form-input', 'id': 'addressInput', 'placeholder': 'Street name, City'}}) }}
            {{ form_errors(form.address) }}
            <label class="form-label" style="margin-top: var(--space-md);">Location on Map <span class="required-star">*</span></label>
            <div id="propertyMap"></div>
            {{ form_widget(form.latitude,  {'attr': {'id': 'latInput'}}) }}
            {{ form_widget(form.longitude, {'attr': {'id': 'lngInput'}}) }}
            <div id="mapCoordHint"></div>
        </div>

        {# ── Price / Bedrooms / Rooms ── #}
        <div class="field-grid-3">
            <div class="form-group">
                <label class="form-label" for="{{ form.price.vars.id }}">Price (TND/mo) <span class="required-star">*</span></label>
                {{ form_widget(form.price, {'attr': {'class': 'form-input', 'placeholder': '0.00'}}) }}
                {{ form_errors(form.price) }}
            </div>
            <div class="form-group">
                <label class="form-label" for="{{ form.bedrooms.vars.id }}">Bedrooms <span class="required-star">*</span></label>
                {{ form_widget(form.bedrooms, {'attr': {'class': 'form-input', 'min': '1'}}) }}
                {{ form_errors(form.bedrooms) }}
            </div>
            <div class="form-group">
                <label class="form-label" for="{{ form.bedsCount.vars.id }}">Rooms <span class="required-star">*</span></label>
                {{ form_widget(form.bedsCount, {'attr': {'class': 'form-input', 'min': '1'}}) }}
                {{ form_errors(form.bedsCount) }}
            </div>
        </div>

        {# ── Total Student Capacity ── #}
        <div class="form-group">
            <label class="form-label" for="{{ form.capacity.vars.id }}">Total Student Capacity <span class="required-star">*</span></label>
            {{ form_widget(form.capacity, {'attr': {'class': 'form-input', 'placeholder': 'Max students allowed', 'min': '1'}}) }}
            {{ form_errors(form.capacity) }}
        </div>

        {# ── Bathrooms ── #}
        <div class="form-group" style="max-width:200px;">
            <label class="form-label" for="{{ form.bathrooms.vars.id }}">Bathrooms <span class="required-star">*</span></label>
            {{ form_widget(form.bathrooms, {'attr': {'class': 'form-input', 'min': '1'}}) }}
            {{ form_errors(form.bathrooms) }}
        </div>

        {# ── Property Type ── #}
        <div class="form-group">
            <label class="form-label" for="{{ form.propertyType.vars.id }}">Property Type <span class="required-star">*</span></label>
            {{ form_widget(form.propertyType, {'attr': {'class': 'form-input'}}) }}
            {{ form_errors(form.propertyType) }}
        </div>

        {# ── Gender Preference ── #}
        <div class="form-group">
            <label class="form-label" for="{{ form.genderPreference.vars.id }}">Gender Preference <span class="required-star">*</span></label>
            {{ form_widget(form.genderPreference, {'attr': {'class': 'form-input'}}) }}
            {{ form_errors(form.genderPreference) }}
            <span class="form-hint">Specify if this listing is restricted to a specific gender.</span>
        </div>

        {# ── Availability ── #}
        <div class="field-grid-2">
            <div class="form-group">
                <label class="form-label" for="{{ form.availableFrom.vars.id }}">Available From</label>
                {{ form_widget(form.availableFrom, {'attr': {'class': 'form-input'}}) }}
                {{ form_errors(form.availableFrom) }}
            </div>
            <div class="form-group">
                <label class="form-label" for="{{ form.availableUntil.vars.id }}">Available Until</label>
                {{ form_widget(form.availableUntil, {'attr': {'class': 'form-input'}}) }}
                {{ form_errors(form.availableUntil) }}
            </div>
        </div>

        {# ── Property Images ── #}
        <div class="form-group">
            <label class="form-label" for="{{ form.images.vars.id }}">
                Property Images <span class="required-star">*</span>
                <span style="font-weight:400; font-size:0.8rem; color: var(--color-text-muted,#6b7280);">(Select one or more)</span>
            </label>
            {{ form_widget(form.images, {'attr': {'class': 'form-input', 'accept': 'image/*', 'id': 'propertyImagesInput'}}) }}
            {{ form_errors(form.images) }}
            <div id="imagePreviews" class="image-previews"></div>
        </div>

        {# ── Digital Signature ── #}
        <div class="form-group">
            <label class="form-label">
                Digital Signature <span class="required-star">*</span>
            </label>
            <div id="signature-pad-container"></div>
            {{ form_widget(form.ownerSignature, {'attr': {'id': 'ownerSignatureInput'}}) }}
            <p class="form-hint" style="margin-top:0.5rem;">
                Please sign to authorize contract generation. This signature will appear on all contracts for this property.
            </p>
        </div>

        <button type="submit" class="btn btn-primary" style="width:100%; padding: var(--space-md); margin-top: var(--space-md); font-size:1rem;" id="createListingBtn">
            Create Listing
        </button>

        {{ form_end(form) }}
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script src="/js/signature-pad.js"></script>
<script>
// ── Map picker ──────────────────────────────────────────────────────────────
const map = L.map('propertyMap').setView([36.8, 10.1], 10);
L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    attribution: '© OpenStreetMap contributors'
}).addTo(map);
let marker;
map.on('click', function(e) {
    const { lat, lng } = e.latlng;
    document.getElementById('latInput').value = lat.toFixed(6);
    document.getElementById('lngInput').value = lng.toFixed(6);
    document.getElementById('mapCoordHint').textContent = '📍 Selected: ' + lat.toFixed(5) + ', ' + lng.toFixed(5);
    if (marker) marker.setLatLng(e.latlng);
    else marker = L.marker(e.latlng).addTo(map);
});

// ── Image previews ──────────────────────────────────────────────────────────
const imagesInput = document.getElementById('propertyImagesInput');
const previewsContainer = document.getElementById('imagePreviews');
let selectedFiles = [];

imagesInput.addEventListener('change', function() {
    selectedFiles = Array.from(this.files);
    renderPreviews();
});

function renderPreviews() {
    previewsContainer.innerHTML = '';
    selectedFiles.forEach(function(file, idx) {
        const reader = new FileReader();
        reader.onload = function(e) {
            const item = document.createElement('div');
            item.className = 'preview-item';
            item.innerHTML =
                '<img src="' + e.target.result + '" alt="preview">' +
                '<button type="button" class="preview-remove" data-idx="' + idx + '">✕</button>';
            previewsContainer.appendChild(item);
        };
        reader.readAsDataURL(file);
    });
}

previewsContainer.addEventListener('click', function(e) {
    if (e.target.classList.contains('preview-remove')) {
        const idx = parseInt(e.target.dataset.idx, 10);
        selectedFiles.splice(idx, 1);
        // Rebuild the FileList via DataTransfer
        const dt = new DataTransfer();
        selectedFiles.forEach(function(f) { dt.items.add(f); });
        imagesInput.files = dt.files;
        renderPreviews();
    }
});

// ── Signature pad ────────────────────────────────────────────────────────────
const ownerPad = new UnidarSignaturePad('signature-pad-container', {
    width: 620, height: 160, backgroundColor: '#f8fafc'
});

// ── Form submit validation ───────────────────────────────────────────────────
document.getElementById('createListingForm').addEventListener('submit', function(e) {
    const alert = document.getElementById('formAlert');
    alert.style.display = 'none';

    const lat = document.getElementById('latInput').value;
    const lng = document.getElementById('lngInput').value;
    if (!lat || !lng) {
        e.preventDefault();
        alert.className = 'alert-error';
        alert.textContent = 'Please click on the map to select the property location.';
        alert.style.display = 'block';
        document.getElementById('propertyMap').scrollIntoView({ behavior: 'smooth', block: 'center' });
        return false;
    }

    if (!ownerPad || ownerPad.isEmpty()) {
        e.preventDefault();
        alert.className = 'alert-error';
        alert.textContent = 'Please draw your digital signature before publishing the listing.';
        alert.style.display = 'block';
        document.getElementById('signature-pad-container').scrollIntoView({ behavior: 'smooth', block: 'center' });
        return false;
    }

    document.getElementById('ownerSignatureInput').value = ownerPad.toDataURL();

    // Disable button to prevent double-submit
    const btn = document.getElementById('createListingBtn');
    btn.disabled = true;
    btn.textContent = 'Publishing…';
});
</script>
{% endblock %}
